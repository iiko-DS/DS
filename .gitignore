# ── VS Code: локальный MCP-конфиг (содержит токен Figma) ──
# Реальный файл с токеном не коммитим. Для команды есть .vscode/mcp.example.json
.vscode/mcp.json

# ── Переменные окружения / секреты ──
.env
.env.*
*.local

# ── Вложенные репозитории: у них свой git (iiko-ds-web, iiko-ds-prototypes) ──
/iiko-ds-web/
/iiko-ds-prototypes/

# ── Мусор Python и кэши ──
__pycache__/
*.pyc

# ── Рабочий мусор: пробы, снимки, бэкапы ──
_crops/
_probe.*
*.log
*.tmp
*.bak
*.orig
*.rej
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Сырьё, из которого собираются platform/*.json (пересобирается скриптами _src) ──
_audit/platform/_raw/


# ── Мобильный слой: пока ведём локально, в репозиторий не выгружаем ──
/iiko-ds-mobile/
