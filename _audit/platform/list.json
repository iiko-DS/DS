          "height_dp": 64
        },
        {
          "name": "Высота строки three-line (плотность 0)",
          "quote": "list-list-item-three-line-container-height:\n        list.nth((88px, 84px, 80px, 76px, 72px, 56px), $index),",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
          "height_dp": 88
        },
        {
          "name": "Отступы ведущей иконки (start/end space), плотность 0",
          "quote": "list-list-item-leading-icon-start-space: list.nth((16px, 12px, 8px, 4px, 4px, 4px), $index),\n    list-list-item-leading-icon-end-space: list.nth((16px, 12px, 8px, 4px, 4px, 4px), $index),",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
          "value": 16,
          "unit": "px"
        },
        {
          "name": "Размер ведущей иконки",
          "quote": "// Match spec, which has list-item-leading-icon-size of 24px.\n    // Current version of tokens (0_161) has 18px.\n    list-list-item-leading-icon-size: 24px,",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
          "value": 24,
          "unit": "px"
        },
        {
          "name": "Размер завершающей иконки",
          "quote": "list-list-item-trailing-icon-size: 24px,",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
          "value": 24,
          "unit": "px"
        },
        {
          "name": "Размер аватара",
          "quote": "list-list-item-leading-avatar-size: 40px,",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
          "value": 40,
          "unit": "px"
        },
        {
          "name": "Основной текст = body-large",
          "quote": "list-list-item-label-text-size: map.get($system, body-large-size),",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
          "value": "body-large"
        },
        {
          "name": "Supporting text = body-medium",
          "quote": "list-list-item-supporting-text-size: map.get($system, body-medium-size),",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
          "value": "body-medium"
        },
        {
          "name": "Trailing supporting text = label-small",
          "quote": "list-list-item-trailing-supporting-text-size: map.get($system, label-small-size),",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
          "value": "label-small"
        },
        {
          "name": "Отступ divider рядом с аватаром",
          "quote": ".mat-mdc-list-item-avatar ~ .mat-divider-inset {\n    margin-left: 72px;",
          "source": "https://raw.githubusercontent.com/angular/components/main/src/material/list/list.scss",
          "value": 72,
          "unit": "px"
        }
      ],
      "variants": [
        "simple list (<mat-list-item> с текстом напрямую)",
        "multi-line list (matListItemTitle + matListItemLine; вход lines=N включает перенос текста)",
        "mat-nav-list (role=\"navigation\", только ссылки)",
        "mat-action-list (каждый элемент — <button>)",
        "mat-selection-list + mat-list-option (role=\"listbox\")",
        "подзаголовки matSubheader + <mat-divider>",
        "слоты строки: matListItemIcon, matListItemAvatar, matListItemMeta, matListItemTitle, matListItemLine"
      ],
      "density": "Есть: clamp-density($scale, -5). one-line (48, 44, 40, 36, 32, 24); two-line (64, 60, 56, 52, 48, 48); three-line (88, 84, 80, 76, 72, 56); отступы иконки (16, 12, 8, 4, 4, 4).",
      "touch_target_dp": null,
      "touch_target_note_ru": "Для mat-list токена touch target нет — не найдено. Общий M3-touch-target в Angular Material равен 48 px, но заведён он у кнопок: '$touch-target-size: 48px;' (https://raw.githubusercontent.com/angular/components/main/src/material/button/_m3-button.scss).",
      "notes_ru": "Ключевое расхождение: в M3-теме Angular Material высоты строк 48/64/88 px (плотность 0), а в токенах MD3 — 56/72/88. Не совпадает one-line (48 против 56) и two-line (64 против 72). В комментариях исходников отмечено только расхождение по цвету контейнера и по размеру ведущей иконки ('Match spec, which has list-item-leading-icon-size of 24px. Current version of tokens (0_161) has 18px.'); про высоты комментариев нет. Отступ 72 px применяется к вложенному divider рядом с аватаром.",
      "sources": [
        "https://raw.githubusercontent.com/angular/components/main/src/material/list/list.md",
        "https://raw.githubusercontent.com/angular/components/main/src/material/list/_m3-list.scss",
        "https://raw.githubusercontent.com/angular/components/main/src/material/list/list.scss",
        "https://raw.githubusercontent.com/angular/components/main/src/material/button/_m3-button.scss"
      ]
    },
