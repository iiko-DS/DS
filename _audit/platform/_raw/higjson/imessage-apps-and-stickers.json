{"abstract": [{"text": "An iMessage app can help people share content, collaborate, and even play games with others in a conversation; stickers are images that people can use to decorate a conversation.", "type": "text"}], "hierarchy": {"paths": [["doc://com.apple.documentation/documentation/technologies", "doc://com.apple.HIG/design/human-interface-guidelines", "doc://com.apple.HIG/design/Human-Interface-Guidelines/technologies"]]}, "identifier": {"interfaceLanguage": "swift", "url": "doc://com.apple.HIG/design/Human-Interface-Guidelines/imessage-apps-and-stickers"}, "kind": "article", "legalNotices": {"copyright": "Copyright &copy; 2026 Apple Inc. All rights reserved.", "privacyPolicy": "https://www.apple.com/privacy/privacy-policy", "termsOfUse": "https://www.apple.com/legal/internet-services/terms/site.html"}, "metadata": {"availableLanguages": ["en-US", "zh-CN", "ja-JP", "ko-KR"], "customMetadata": {"alert-date": "2023-05-02", "alert-text": "Consolidated guidance into one page.", "supported-platforms": "ios,ipados"}, "images": [{"identifier": "imessage-app.svg", "type": "icon"}, {"identifier": "technologies-imessage-apps-thumbnail.png", "type": "card"}], "role": "article", "title": "iMessage apps and stickers"}, "primaryContentSections": [{"content": [{"inlineContent": [{"identifier": "technologies-iMessage-Apps-intro.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"text": "An iMessage app or sticker pack is available within the context of a Messages conversation and also in effects in both Messages and FaceTime. You can create an iMessage app or sticker pack as a standalone app or as an app extension within your iOS or iPadOS app. For developer guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/Messages", "isActive": true, "type": "reference"}, {"text": " and ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/Messages/adding-sticker-packs-and-imessage-apps-to-the-system-stickers-app-messages-camera-and-facetime", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"anchor": "Best-practices", "level": 2, "text": "Best practices", "type": "heading"}, {"inlineContent": [{"inlineContent": [{"text": "Prefer providing one primary experience in your iMessage app.", "type": "text"}], "type": "strong"}, {"text": " People are in a conversational flow when they choose your app, so your functionality or content needs to be easy to understand and immediately available. If you want to provide multiple types of functionality or different collections of content, consider creating a separate iMessage app for each one.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Consider surfacing content from your iOS or iPadOS app.", "type": "text"}], "type": "strong"}, {"text": " For example, your iMessage app could offer app-specific information that people might want to share \u2014 such as a shopping list or a trip itinerary \u2014 or support a simple, collaborative task, like deciding where to go for a meal or which movie to watch.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Present essential features in the compact view.", "type": "text"}], "type": "strong"}, {"text": " People can experience your iMessage app in a compact view that appears below the message transcript, or they can expand the view to occupy most of the window. Make sure the most frequently used items are available in the compact view, reserving additional content and features for the expanded view.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "In general, let people edit text only in the expanded view.", "type": "text"}], "type": "strong"}, {"text": " The compact view occupies roughly the same space as the keyboard. To ensure that the iMessage app\u2019s content remains visible while people edit, display the keyboard in the expanded view.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Create stickers that are expressive, inclusive, and versatile.", "type": "text"}], "type": "strong"}, {"text": " Whether your stickers are rich, static images or short animations, make sure that each one remains legible against a wide range of backgrounds and when rotated or scaled. You can also use transparency to help people visually integrate a sticker with text, photos, and other stickers.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "For each sticker, provide a localized alternative description.", "type": "text"}], "type": "strong"}, {"text": " VoiceOver can help people use your sticker pack by speaking a sticker\u2019s alternative description.", "type": "text"}], "type": "paragraph"}, {"anchor": "Specifications", "level": 2, "text": "Specifications", "type": "heading"}, {"anchor": "Icon-sizes", "level": 3, "text": "Icon sizes", "type": "heading"}, {"inlineContent": [{"text": "The icon for an iMessage app or sticker pack can appear in Messages, the App Store, notifications, and Settings. After people install your iMessage app or sticker pack, its icon also appears in the app drawer in the Messages app.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"text": "You supply a square-cornered icon for each extension you offer, and the system automatically applies a mask that rounds the corners.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"text": "To ensure that your icon looks great in any context and on various devices, create a square-cornered icon in the following sizes:", "type": "text"}], "type": "paragraph"}, {"header": "row", "rows": [[[{"inlineContent": [{"text": "Usage", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "@2x (pixels)", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "@3x (pixels)", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "Messages, notifications", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "148x110", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "-", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [], "type": "paragraph"}], [{"inlineContent": [{"text": "143x100", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "-", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [], "type": "paragraph"}], [{"inlineContent": [{"text": "120x90", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "180x135", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [], "type": "paragraph"}], [{"inlineContent": [{"text": "64x48", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "96x72", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [], "type": "paragraph"}], [{"inlineContent": [{"text": "54x40", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "81x60", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "Settings", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "58x58", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "87x87", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "App Store", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "1024x1024", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "1024x1024", "type": "text"}], "type": "paragraph"}]]], "type": "table"}, {"anchor": "Sticker-sizes", "level": 3, "text": "Sticker sizes", "type": "heading"}, {"inlineContent": [{"text": "Messages supports small, regular, and large stickers. Pick the size that works best for your content and prepare all of your stickers at that size; don\u2019t mix sizes within a single sticker pack. Messages displays stickers in a grid, organized differently for different sizes.", "type": "text"}], "type": "paragraph"}, {"columns": [{"alignment": "leading", "content": [{"inlineContent": [{"identifier": "sticker-sizes-small.png", "metadata": {"abstract": [{"text": "Small", "type": "text"}], "deviceFrame": "iPhone16-bottom-half"}, "type": "image"}], "type": "paragraph"}], "size": 1}, {"alignment": "leading", "content": [{"inlineContent": [{"identifier": "sticker-sizes-regular.png", "metadata": {"abstract": [{"text": "Regular", "type": "text"}], "deviceFrame": "iPhone16-bottom-half"}, "type": "image"}], "type": "paragraph"}], "size": 1}, {"alignment": "leading", "content": [{"inlineContent": [{"identifier": "sticker-sizes-large.png", "metadata": {"abstract": [{"text": "Large", "type": "text"}], "deviceFrame": "iPhone16-bottom-half"}, "type": "image"}], "type": "paragraph"}], "size": 1}], "numberOfColumns": 3, "type": "row"}, {"inlineContent": [{"text": "Create your sticker images using the following @3x dimensions for the sticker size you chose. If necessary, the system generates @2x and @1x versions by downscaling the images at runtime. For developer guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/Messages/MSStickerSize", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"header": "row", "rows": [[[{"inlineContent": [{"text": "Sticker size", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "@3x dimensions (pixels)", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "Small", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "300x300", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "Regular", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "408x408", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "Large", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "618x618", "type": "text"}], "type": "paragraph"}]]], "type": "table"}, {"inlineContent": [{"text": "A sticker file must be 500 KB or smaller in size. For each supported format, the table below provides guidance for using transparency and animation.", "type": "text"}], "type": "paragraph"}, {"header": "row", "rows": [[[{"inlineContent": [{"text": "Format", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Transparency", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Animation", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "PNG", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "8-bit", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "No", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "APNG", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "8-bit", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Yes", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "GIF", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Single-color", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Yes", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "JPEG", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "No", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "No", "type": "text"}], "type": "paragraph"}]]], "type": "table"}, {"anchor": "Platform-considerations", "level": 2, "text": "Platform considerations", "type": "heading"}, {"inlineContent": [{"inlineContent": [{"text": "No additional considerations for iOS or iPadOS. Not supported in macOS, tvOS, visionOS, or watchOS.", "type": "text"}], "type": "emphasis"}], "type": "paragraph"}, {"anchor": "Resources", "level": 2, "text": "Resources", "type": "heading"}, {"anchor": "Related", "level": 4, "text": "Related", "type": "heading"}, {"inlineContent": [{"identifier": "https://developer.apple.com/imessage/", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"anchor": "Developer-documentation", "level": 4, "text": "Developer documentation", "type": "heading"}, {"inlineContent": [{"identifier": "doc://com.apple.documentation/documentation/Messages", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "doc://com.apple.documentation/documentation/Messages/adding-sticker-packs-and-imessage-apps-to-the-system-stickers-app-messages-camera-and-facetime", "isActive": true, "type": "reference"}, {"text": " \u2014 Messages", "type": "text"}], "type": "paragraph"}, {"anchor": "Videos", "level": 4, "text": "Videos", "type": "heading"}, {"items": ["doc://com.apple.documentation/videos/play/wwdc2017/820"], "style": "compactGrid", "type": "links"}, {"anchor": "Change-log", "level": 2, "text": "Change log", "type": "heading"}, {"header": "row", "rows": [[[{"inlineContent": [{"text": "Date", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Changes", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "May 2, 2023", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Consolidated guidance into one page.", "type": "text"}], "type": "paragraph"}]]], "type": "table"}], "kind": "content"}], "schemaVersion": {"major": 0, "minor": 3, "patch": 0}, "sections": [], "topicSectionsStyle": "compactGrid", "references": {"FC4A4C67-CCE9-46D5-9376-D071D53B4FB2": {"alt": null, "identifier": "FC4A4C67-CCE9-46D5-9376-D071D53B4FB2", "type": "image", "variants": [{"traits": ["1x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/7/FC4A4C67-CCE9-46D5-9376-D071D53B4FB2/1925_wide_250x141_1x.jpg"}, {"traits": ["2x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/7/FC4A4C67-CCE9-46D5-9376-D071D53B4FB2/1925_wide_250x141_2x.jpg"}, {"traits": ["3x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/7/FC4A4C67-CCE9-46D5-9376-D071D53B4FB2/1925_wide_250x141_3x.jpg"}]}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/technologies": {"abstract": [{"text": "Discover the Apple technologies, features, and services you can integrate into your app or game.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/technologies", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "technologies.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Technologies", "type": "topic", "url": "/design/human-interface-guidelines/technologies"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/Messages": {"abstract": [{"text": "Create app extensions that allow users to send text, stickers, media files, and interactive messages.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/Messages", "kind": "symbol", "role": "collection", "title": "Messages", "type": "topic", "url": "/documentation/messages"}, "doc://com.apple.documentation/documentation/Messages/MSStickerSize": {"abstract": [{"text": "The size of the stickers in the browser view.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "enum"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "MSStickerSize"}], "identifier": "doc://com.apple.documentation/documentation/Messages/MSStickerSize", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "MSStickerSize"}], "role": "symbol", "title": "MSStickerSize", "type": "topic", "url": "/documentation/messages/msstickersize"}, "doc://com.apple.documentation/documentation/Messages/adding-sticker-packs-and-imessage-apps-to-the-system-stickers-app-messages-camera-and-facetime": {"abstract": [{"text": "Enable your Sticker pack or iMessage app in the media context.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/Messages/adding-sticker-packs-and-imessage-apps-to-the-system-stickers-app-messages-camera-and-facetime", "kind": "article", "role": "article", "title": "Adding Sticker packs and iMessage apps to the system Stickers app, Messages camera, and FaceTime", "type": "topic", "url": "/documentation/messages/adding-sticker-packs-and-imessage-apps-to-the-system-stickers-app-messages-camera-and-facetime"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "doc://com.apple.documentation/videos/play/wwdc2017/820": {"abstract": [{"text": "iMessage Apps help people easily create and share content, play games, and collaborate with friends without needing to leave the conversation. Explore how you can design iMessage apps and sticker packs that are perfectly suited for a deeply social context.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2017/820", "images": [{"identifier": "FC4A4C67-CCE9-46D5-9376-D071D53B4FB2", "type": "card"}], "kind": "article", "role": "article", "title": "Express Yourself!", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2017/820"}, "https://developer.apple.com/imessage/": {"identifier": "https://developer.apple.com/imessage/", "title": "iMessage Apps and Stickers", "titleInlineContent": [{"text": "iMessage Apps and Stickers", "type": "text"}], "type": "link", "url": "https://developer.apple.com/imessage/"}, "human-interface-guidelines-page-image-card.png": {"alt": "An illustration of several Liquid Glass components such as toggles, sliders, and buttons, atop a neutral background. The transparent components cast shadows on the background and allow their colored elements, like a blue slider track and a green toggle backing, to show through, highlighting the Liquid Glass material's lensing effect.", "identifier": "human-interface-guidelines-page-image-card.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/human-interface-guidelines-page-image-card@2x.png"}]}, "imessage-app.svg": {"alt": "The iMessage App Store icon.", "identifier": "imessage-app.svg", "type": "image", "variants": [{"svgID": "Design-Spec", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/imessage-app.svg"}]}, "overview.svg": {"alt": "An icon of a grid comprised of four squares.", "identifier": "overview.svg", "type": "image", "variants": [{"svgID": "overview", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/overview.svg"}]}, "sticker-sizes-large.png": {"alt": "An illustration showing a grid of large stickers in the bottom half of an iPhone screen. Two stickers are fully visible in the area, followed by a partial row of two additional stickers.", "identifier": "sticker-sizes-large.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/sticker-sizes-large@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/sticker-sizes-large~dark@2x.png"}]}, "sticker-sizes-regular.png": {"alt": "An illustration showing a grid of regular stickers in the bottom half of an iPhone screen. Six stickers are visible in the area, in two rows of three.", "identifier": "sticker-sizes-regular.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/sticker-sizes-regular@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/sticker-sizes-regular~dark@2x.png"}]}, "sticker-sizes-small.png": {"alt": "An illustration showing a grid of small stickers in the bottom half of an iPhone screen. Eight stickers are visible in the area, followed by a partial row of four, arranged in three rows.", "identifier": "sticker-sizes-small.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/sticker-sizes-small@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/sticker-sizes-small~dark@2x.png"}]}, "technologies-iMessage-Apps-intro.png": {"alt": "A sketch of the iMessage App Store icon. The image is overlaid with rectangular and circular grid lines and is tinted blue to subtly reflect the blue in the original six-color Apple logo.", "identifier": "technologies-iMessage-Apps-intro.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/technologies-iMessage-Apps-intro@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/technologies-iMessage-Apps-intro~dark@2x.png"}]}, "technologies-imessage-apps-thumbnail.png": {"alt": "A sketch of the iMessage App Store icon. The image is tinted blue to subtly reflect the blue in the original six-color Apple logo.", "identifier": "technologies-imessage-apps-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/technologies-imessage-apps-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/technologies-imessage-apps-thumbnail~dark@2x.png"}]}, "technologies.png": {"alt": "", "identifier": "technologies.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/technologies@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/technologies~dark@2x.png"}]}}, "variantOverrides": [{"patch": [{"op": "replace", "path": "/references/doc:~1~1com.apple.documentation~1documentation~1Messages~1MSStickerSize/fragments", "value": [{"kind": "identifier"