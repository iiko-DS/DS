randing": {"abstract": [{"text": "Apps and games express their unique brand identity in ways that make them instantly recognizable while feeling at home on the platform and giving people a consistent experience.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/branding", "images": [{"identifier": "branding.svg", "type": "icon"}, {"identifier": "foundations-branding-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Branding", "type": "topic", "url": "/design/human-interface-guidelines/branding"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/color": {"abstract": [{"text": "Judicious use of color can enhance communication, evoke your brand, provide visual continuity, communicate status and feedback, and help people understand information.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/color", "images": [{"identifier": "color.svg", "type": "icon"}, {"identifier": "foundations-color-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Color", "type": "topic", "url": "/design/human-interface-guidelines/color"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/dark-mode": {"abstract": [{"text": "Dark Mode is a systemwide appearance setting that uses a dark color palette to provide a comfortable viewing experience tailored for low-light environments.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/dark-mode", "images": [{"identifier": "dark-mode.svg", "type": "icon"}, {"identifier": "foundations-dark-mode-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Dark Mode", "type": "topic", "url": "/design/human-interface-guidelines/dark-mode"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/icons": {"abstract": [{"text": "An effective icon is a graphic asset that expresses a single concept in ways people instantly understand.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/icons", "images": [{"identifier": "icons.svg", "type": "icon"}, {"identifier": "foundations-icons-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Icons", "type": "topic", "url": "/design/human-interface-guidelines/icons"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/images": {"abstract": [{"text": "To make sure your artwork looks great on all devices you support, learn how the system displays content and how to deliver art at the appropriate scale factors.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/images", "images": [{"identifier": "images.svg", "type": "icon"}, {"identifier": "foundations-images-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Images", "type": "topic", "url": "/design/human-interface-guidelines/images"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/immersive-experiences": {"abstract": [{"text": "In visionOS, you can design apps and games that extend beyond windows and volumes, immersing people in your content.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/immersive-experiences", "images": [{"identifier": "immersive-experiences.svg", "type": "icon"}, {"identifier": "foundations-immersive-experiences-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Immersive experiences", "type": "topic", "url": "/design/human-interface-guidelines/immersive-experiences"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/inclusion": {"abstract": [{"text": "Inclusive apps and games put people first by prioritizing respectful communication and presenting content and functionality in ways that everyone can access and understand.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/inclusion", "images": [{"identifier": "inclusion.svg", "type": "icon"}, {"identifier": "foundations-inclusion-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Inclusion", "type": "topic", "url": "/design/human-interface-guidelines/inclusion"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/layout": {"abstract": [{"text": "A consistent layout that adapts across display sizes, orientations, and multitasking configurations helps people understand and enjoy your app or game on all their devices.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/layout", "images": [{"identifier": "layout.svg", "type": "icon"}, {"identifier": "foundations-layout-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Layout", "type": "topic", "url": "/design/human-interface-guidelines/layout"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/materials": {"abstract": [{"text": "A material is a visual effect that creates a sense of depth, layering, and hierarchy between foreground and background elements.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/materials", "images": [{"identifier": "materials.svg", "type": "icon"}, {"identifier": "foundations-materials-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Materials", "type": "topic", "url": "/design/human-interface-guidelines/materials"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/motion": {"abstract": [{"text": "Beautiful, fluid motions bring the interface to life, conveying status, providing feedback and instruction, and enriching the visual experience of your app or game.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/motion", "images": [{"identifier": "motion.svg", "type": "icon"}, {"identifier": "foundations-motion-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Motion", "type": "topic", "url": "/design/human-interface-guidelines/motion"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/privacy": {"abstract": [{"text": "Privacy is paramount: it\u2019s critical to be transparent about the privacy-related data and resources you require and essential to protect the data people allow you to access.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/privacy", "images": [{"identifier": "privacy.svg", "type": "icon"}, {"identifier": "foundations-privacy-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Privacy", "type": "topic", "url": "/design/human-interface-guidelines/privacy"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/right-to-left": {"abstract": [{"text": "Support right-to-left languages like Arabic and Hebrew by reversing your interface as needed to match the reading direction of the related scripts.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/right-to-left", "images": [{"identifier": "right-to-left.svg", "type": "icon"}, {"identifier": "foundations-right-to-left-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Right to left", "type": "topic", "url": "/design/human-interface-guidelines/right-to-left"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/sf-symbols": {"abstract": [{"text": "SF Symbols provides thousands of consistent, highly configurable symbols that integrate seamlessly with the San Francisco system font, automatically aligning with text in all weights and sizes.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/sf-symbols", "images": [{"identifier": "sf-symbols.svg", "type": "icon"}, {"identifier": "foundations-sf-symbols-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "SF Symbols", "type": "topic", "url": "/design/human-interface-guidelines/sf-symbols"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/spatial-layout": {"abstract": [{"text": "Spatial layout techniques help you take advantage of the infinite canvas of Apple\u00a0Vision\u00a0Pro and present your content in engaging, comfortable ways.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/spatial-layout", "images": [{"identifier": "spatial-layout.svg", "type": "icon"}, {"identifier": "foundations-spatial-layout-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Spatial layout", "type": "topic", "url": "/design/human-interface-guidelines/spatial-layout"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/typography": {"abstract": [{"text": "Your typographic choices can help you display legible text, convey an information hierarchy, communicate important content, and express your brand or style.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/typography", "images": [{"identifier": "typography.svg", "type": "icon"}, {"identifier": "foundations-typography-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Typography", "type": "topic", "url": "/design/human-interface-guidelines/typography"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/writing": {"abstract": [{"text": "The words you choose within your app are an essential part of its user experience.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/writing", "images": [{"identifier": "writing.svg", "type": "icon"}, {"identifier": "foundations-writing-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Writing", "type": "topic", "url": "/design/human-interface-guidelines/writing"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc