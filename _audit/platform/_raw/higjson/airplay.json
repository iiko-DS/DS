{"abstract": [{"text": "AirPlay lets people stream media content wirelessly from iOS, iPadOS, macOS, and tvOS devices to Apple TV, HomePod, and TVs and speakers that support AirPlay.", "type": "text"}], "hierarchy": {"paths": [["doc://com.apple.documentation/documentation/technologies", "doc://com.apple.HIG/design/human-interface-guidelines", "doc://com.apple.HIG/design/Human-Interface-Guidelines/technologies"]]}, "identifier": {"interfaceLanguage": "swift", "url": "doc://com.apple.HIG/design/Human-Interface-Guidelines/airplay"}, "kind": "article", "legalNotices": {"copyright": "Copyright &copy; 2026 Apple Inc. All rights reserved.", "privacyPolicy": "https://www.apple.com/privacy/privacy-policy", "termsOfUse": "https://www.apple.com/legal/internet-services/terms/site.html"}, "metadata": {"availableLanguages": ["en-US", "zh-CN", "ja-JP", "ko-KR"], "customMetadata": {"alert-date": "2023-05-02", "alert-text": "Consolidated guidance into one page.", "supported-platforms": "ios,ipados,macos,tvos,visionos,watchos"}, "images": [{"identifier": "airplay.svg", "type": "icon"}, {"identifier": "technologies-airplay-thumbnail.png", "type": "card"}], "role": "article", "title": "AirPlay"}, "primaryContentSections": [{"content": [{"inlineContent": [{"identifier": "technologies-AirPlay-intro.png", "type": "image"}], "type": "paragraph"}, {"anchor": "Best-practices", "level": 2, "text": "Best practices", "type": "heading"}, {"inlineContent": [{"inlineContent": [{"text": "Prefer the system-provided media player.", "type": "text"}], "type": "strong"}, {"text": " The built-in media player offers a standard set of controls and supports features like chapter navigation, subtitles, closed captioning, and AirPlay streaming. It\u2019s also easy to implement, provides a consistent and familiar playback experience across the system, and accommodates the needs of most media apps. Consider designing a custom video player only if the system-provided player doesn\u2019t meet your app\u2019s needs. For developer guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/AVKit/AVPlayerViewController", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "airplay-video-screen.png", "metadata": {"deviceFrame": "iPhone16-landscape"}, "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Provide content in the highest possible resolution.", "type": "text"}], "type": "strong"}, {"text": " Your ", "type": "text"}, {"identifier": "https://developer.apple.com/documentation/http-live-streaming", "isActive": true, "type": "reference"}, {"text": " (HLS) playlist needs to include the full range of available resolutions so that people can experience your content in the resolution that\u2019s appropriate for the device they\u2019re using (AVFoundation automatically selects the resolution based on the device). If you don\u2019t include a range of resolutions, your content looks low quality when people stream it to a device that can play at higher resolutions. For example, content that looks great on iPhone at 720p will look low quality when people use AirPlay to stream it to a 4K TV.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Stream only the content people expect.", "type": "text"}], "type": "strong"}, {"text": " Avoid streaming content like background loops and short video experiences that make sense only within the context of the app itself. For developer guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/AVFoundation/AVPlayer/usesExternalPlaybackWhileExternalScreenIsActive", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Support both AirPlay streaming and mirroring.", "type": "text"}], "type": "strong"}, {"text": " Supporting both features gives people the most flexibility.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Support remote control events.", "type": "text"}], "type": "strong"}, {"text": " When you do, people can choose actions like play, pause, and fast forward on the lock screen, and through interaction with Siri or HomePod. For developer guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/MediaPlayer/remote-command-center-events", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Don\u2019t stop playback when your app enters the background or when the device locks.", "type": "text"}], "type": "strong"}, {"text": " For example, people expect the TV show they started streaming from your app to continue while they check their mail or put their device to sleep. In this type of scenario, it\u2019s also crucial to avoid automatic mirroring because people don\u2019t want to stream other content on their device without explicitly choosing to do so.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Don\u2019t interrupt another app\u2019s playback unless your app is starting to play immersive content.", "type": "text"}], "type": "strong"}, {"text": " For example, if your app plays a video when it launches or auto-plays inline videos, play this content on only the local device, while allowing current playback to continue. For developer guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/AVFAudio/AVAudioSession/Category-swift.struct/ambient", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Let people use other parts of your app during playback.", "type": "text"}], "type": "strong"}, {"text": " When AirPlay is active, your app needs to remain functional. If people navigate away from the playback screen, make sure other in-app videos don\u2019t begin playing and interrupt the streaming content.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "If necessary, provide a custom interface for controlling media playback.", "type": "text"}], "type": "strong"}, {"text": " If you can\u2019t use the system-provided media player, you can create a custom media player that gives people an intuitive way to enter AirPlay. If you need to do this, be sure to provide custom buttons that match the appearance and behavior of the system-provided ones, including distinct visual states that indicate when playback starts, is occurring, or is unavailable. Use only Apple-provided symbols in custom controls that initiate AirPlay, and position the AirPlay icon correctly in your custom player \u2014 that is, in the lower-right corner (in iOS 16 and iPadOS 16 and later).", "type": "text"}], "type": "paragraph"}, {"anchor": "Using-AirPlay-icons", "level": 2, "text": "Using AirPlay icons", "type": "heading"}, {"inlineContent": [{"text": "You can download AirPlay icons in ", "type": "text"}, {"identifier": "https://developer.apple.com/design/resources/", "isActive": true, "type": "reference"}, {"text": ". You have the following options for displaying the AirPlay icon in your app.", "type": "text"}], "type": "paragraph"}, {"anchor": "Black-AirPlay-icon", "level": 3, "text": "Black AirPlay icon", "type": "heading"}, {"inlineContent": [{"text": "Use the black AirPlay icon on white or light backgrounds when other technology icons also appear in black.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "airplay-black-icon-set.png", "type": "image"}], "type": "paragraph"}, {"anchor": "White-AirPlay-icon", "level": 3, "text": "White AirPlay icon", "type": "heading"}, {"inlineContent": [{"text": "Use the white AirPlay icon on black or dark backgrounds when other technology icons also appear in white.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "airplay-white-icon-set.png", "type": "image"}], "type": "paragraph"}, {"anchor": "Custom-color-AirPlay-icon", "level": 3, "text": "Custom color AirPlay icon", "type": "heading"}, {"inlineContent": [{"text": "Use a custom color when other technology icons also appear in the same color.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "airplay-custom-color-icon-set.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Position the AirPlay icon consistently with other technology icons.", "type": "text"}], "type": "strong"}, {"text": " If you display other technology icons within shapes, you can display the AirPlay icon in the same manner.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Don\u2019t use the AirPlay icon or name in custom buttons or interactive elements.", "type": "text"}], "type": "strong"}, {"text": " Use the icon and the name ", "type": "text"}, {"inlineContent": [{"text": "AirPlay", "type": "text"}], "type": "emphasis"}, {"text": " only in noninteractive ways.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Pair the icon with the name ", "type": "text"}, {"inlineContent": [{"text": "AirPlay", "type": "text"}], "type": "emphasis"}, {"text": " correctly.", "type": "text"}], "type": "strong"}, {"text": " You can show the name below or beside the icon if you also reference other technologies in this way. Use the same font you use in the rest of your layout. Avoid using the AirPlay icon within text or as a replacement for the name ", "type": "text"}, {"inlineContent": [{"text": "AirPlay", "type": "text"}], "type": "emphasis"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Emphasize your app over AirPlay.", "type": "text"}], "type": "strong"}, {"text": " Make references to AirPlay less prominent than your app name or main identity.", "type": "text"}], "type": "paragraph"}, {"anchor": "Referring-to-AirPlay", "level": 2, "text": "Referring to AirPlay", "type": "heading"}, {"inlineContent": [{"inlineContent": [{"text": "Use correct capitalization when using the term ", "type": "text"}, {"inlineContent": [{"text": "AirPlay", "type": "text"}], "type": "emphasis"}, {"text": ".", "type": "text"}], "type": "strong"}, {"text": " ", "type": "text"}, {"inlineContent": [{"text": "AirPlay", "type": "text"}], "type": "emphasis"}, {"text": " is one word, with an uppercase ", "type": "text"}, {"inlineContent": [{"text": "A", "type": "text"}], "type": "emphasis"}, {"text": " and uppercase ", "type": "text"}, {"inlineContent": [{"text": "P", "type": "text"}], "type": "emphasis"}, {"text": ", each followed by lowercase letters. If your layout displays only all-uppercase designations, you can typeset ", "type": "text"}, {"inlineContent": [{"text": "AirPlay", "type": "text"}], "type": "emphasis"}, {"text": " in all uppercase to match the style of the rest of the layout.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Always use ", "type": "text"}, {"inlineContent": [{"text": "AirPlay", "type": "text"}], "type": "emphasis"}, {"text": " as a noun.", "type": "text"}], "type": "strong"}], "type": "paragraph"}, {"header": "row", "rows": [[[{"inlineContent": [], "type": "paragraph"}], [{"inlineContent": [{"text": "Example text", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "checkmark.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Use AirPlay to listen on your speaker", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "crossout.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "AirPlay to your speaker", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "crossout.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "You can AirPlay with [App Name]", "type": "text"}], "type": "paragraph"}]]], "type": "table"}, {"inlineContent": [{"inlineContent": [{"text": "Use terms like ", "type": "text"}, {"inlineContent": [{"text": "works with", "type": "text"}], "type": "emphasis"}, {"text": ", ", "type": "text"}, {"inlineContent": [{"text": "use", "type": "text"}], "type": "emphasis"}, {"text": ", ", "type": "text"}, {"inlineContent": [{"text": "supports", "type": "text"}], "type": "emphasis"}, {"text": ", and ", "type": "text"}, {"inlineContent": [{"text": "compatible", "type": "text"}], "type": "emphasis"}, {"text": ".", "type": "text"}], "type": "strong"}], "type": "paragraph"}, {"header": "row", "rows": [[[{"inlineContent": [], "type": "paragraph"}], [{"inlineContent": [{"text": "Example text", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "checkmark.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "[App Name] is compatible with AirPlay", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "checkmark.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "AirPlay-enabled speaker", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "checkmark.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "You can use AirPlay with [App Name]", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "crossout.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "[App Name] has AirPlay", "type": "text"}], "type": "paragraph"}]]], "type": "table"}, {"inlineContent": [{"inlineContent": [{"text": "Use the name ", "type": "text"}, {"inlineContent": [{"text": "Apple", "type": "text"}], "type": "emphasis"}, {"text": " with the name ", "type": "text"}, {"inlineContent": [{"text": "AirPlay", "type": "text"}], "type": "emphasis"}, {"text": " if desired.", "type": "text"}], "type": "strong"}], "type": "paragraph"}, {"header": "row", "rows": [[[{"inlineContent": [], "type": "paragraph"}], [{"inlineContent": [{"text": "Example text", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "checkmark.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Compatible with Apple AirPlay", "type": "text"}], "type": "paragraph"}]]], "type": "table"}, {"inlineContent": [{"inlineContent": [{"text": "Refer to AirPlay if appropriate and to add clarity.", "type": "text"}], "type": "strong"}, {"text": " If your content is specific to AirPlay, you can use Airplay to make that clear. You can also refer to AirPlay in technical specifications.", "type": "text"}], "type": "paragraph"}, {"header": "row", "rows": [[[{"inlineContent": [], "type": "paragraph"}], [{"inlineContent": [{"text": "Example text", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"identifier": "checkmark.png", "type": "image"}], "type": "paragraph"}], [{"inlineContent": [{"text": "[App Name] now supports AirPlay", "type": "text"}], "type": "paragraph"}]]], "type": "table"}, {"anchor": "Platform-considerations", "level": 2, "text": "Platform considerations", "type": "heading"}, {"inlineContent": [{"inlineContent": [{"text": "No additional considerations for iOS, iPadOS, macOS, tvOS, or visionOS. Not supported in watchOS.", "type": "text"}], "type": "emphasis"}], "type": "paragraph"}, {"anchor": "Resources", "level": 2, "text": "Resources", "type": "heading"}, {"anchor": "Related", "level": 4, "text": "Related", "type": "heading"}, {"inlineContent": [{"identifier": "https://developer.apple.com/design/resources/", "isActive": true, "overridingTitle": "Apple Design Resources", "overridingTitleInlineContent": [{"text": "Apple Design Resources", "type": "text"}], "type": "reference"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "https://www.apple.com/legal/intellectual-property/trademark/appletmlist.html", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "https://www.apple.com/legal/intellectual-property/guidelinesfor3rdparties.html", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"anchor": "Developer-documentation", "level": 4, "text": "Developer documentation", "type": "heading"}, {"inlineContent": [{"identifier": "doc://com.apple.documentation/documentation/AVFoundation", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "doc://com.apple.documentation/documentation/AVKit", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"anchor": "Videos", "level": 4, "text": "Videos", "type": "heading"}, {"items": ["doc://com.apple.documentation/videos/play/wwdc2019/501"], "style": "compactGrid", "type": "links"}, {"anchor": "Change-log", "level": 2, "text": "Change log", "type": "heading"}, {"header": "row", "rows": [[[{"inlineContent": [{"text": "Date", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Changes", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "May 2, 2023", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Consolidated guidance into one page.", "type": "text"}], "type": "paragraph"}]]], "type": "table"}], "kind": "content"}], "schemaVersion": {"major": 0, "minor": 3, "patch": 0}, "sections": [], "topicSectionsStyle": "compactGrid", "references": {"8FCAD355-E1A3-4407-9261-95A3D6026DE8": {"alt": null, "identifier": "8FCAD355-E1A3-4407-9261-95A3D6026DE8", "type": "image", "variants": [{"traits": ["1x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/48/8FCAD355-E1A3-4407-9261-95A3D6026DE8/2661_wide_250x141_1x.jpg"}, {"traits": ["2x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/48/8FCAD355-E1A3-4407-9261-95A3D6026DE8/2661_wide_250x141_2x.jpg"}, {"traits": ["3x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/48/8