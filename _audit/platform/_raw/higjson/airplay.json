rrect usage.", "identifier": "checkmark.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/checkmark@2x.png"}]}, "crossout.png": {"alt": "An X in a circle to indicate incorrect usage.", "identifier": "crossout.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/crossout@2x.png"}]}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/technologies": {"abstract": [{"text": "Discover the Apple technologies, features, and services you can integrate into your app or game.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/technologies", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "technologies.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Technologies", "type": "topic", "url": "/design/human-interface-guidelines/technologies"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/AVFAudio/AVAudioSession/Category-swift.struct/ambient": {"abstract": [{"text": "The category for an app in which sound playback is nonprimary \u2014 that is, your app also works with the sound turned off.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "static"}, {"kind": "text", "text": " "}, {"kind": "keyword", "text": "let"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "ambient"}, {"kind": "text", "text": ": "}, {"kind": "typeIdentifier", "preciseIdentifier": "c:objc(cs)AVAudioSession", "text": "AVAudioSession"}, {"kind": "text", "text": "."}, {"kind": "typeIdentifier", "preciseIdentifier": "c:@T@AVAudioSessionCategory", "text": "Category"}], "identifier": "doc://com.apple.documentation/documentation/AVFAudio/AVAudioSession/Category-swift.struct/ambient", "kind": "symbol", "role": "symbol", "title": "ambient", "type": "topic", "url": "/documentation/avfaudio/avaudiosession/category-swift.struct/ambient"}, "doc://com.apple.documentation/documentation/AVFoundation": {"abstract": [{"text": "Work with audiovisual assets, control device cameras, process audio, and configure system audio interactions.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/AVFoundation", "kind": "symbol", "role": "collection", "title": "AVFoundation", "type": "topic", "url": "/documentation/avfoundation"}, "doc://com.apple.documentation/documentation/AVFoundation/AVPlayer/usesExternalPlaybackWhileExternalScreenIsActive": {"abstract": [{"text": "A Boolean value that indicates whether the player should automatically switch to external playback mode while the external screen mode is active.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "var"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "usesExternalPlaybackWhileExternalScreenIsActive"}, {"kind": "text", "text": ": "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:Sb", "text": "Bool"}], "identifier": "doc://com.apple.documentation/documentation/AVFoundation/AVPlayer/usesExternalPlaybackWhileExternalScreenIsActive", "kind": "symbol", "role": "symbol", "title": "usesExternalPlaybackWhileExternalScreenIsActive", "type": "topic", "url": "/documentation/avfoundation/avplayer/usesexternalplaybackwhileexternalscreenisactive"}, "doc://com.apple.documentation/documentation/AVKit": {"abstract": [{"text": "Create user interfaces for media playback, complete with transport controls, chapter navigation, picture-in-picture support, and display of subtitles and closed captions.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/AVKit", "kind": "symbol", "role": "collection", "title": "AVKit", "type": "topic", "url": "/documentation/avkit"}, "doc://com.apple.documentation/documentation/AVKit/AVPlayerViewController": {"abstract": [{"text": "A view controller that displays content from a player and presents a native user interface to control playback.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "class"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "AVPlayerViewController"}], "identifier": "doc://com.apple.documentation/documentation/AVKit/AVPlayerViewController", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "AVPlayerViewController"}], "role": "symbol", "title": "AVPlayerViewController", "type": "topic", "url": "/documentation/avkit/avplayerviewcontroller"}, "doc://com.apple.documentation/documentation/MediaPlayer/remote-command-center-events": {"abstract": [{"text": "Set up the remote command center to handle media player events.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/MediaPlayer/remote-command-center-events", "kind": "article", "role": "collectionGroup", "title": "Remote command center events", "type": "topic", "url": "/documentation/mediaplayer/remote-command-center-events"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "doc://com.apple.documentation/videos/play/wwdc2019/501": {"abstract": [{"text": "AirPlay lets you share videos, photos, music, and more from Apple devices to your Apple TV, favorite speakers, and popular smart TVs. Learn how to deliver the best possible experience for AirPlay video, including auto