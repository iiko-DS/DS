 "kind": "article", "role": "article", "title": "Charting data", "type": "topic", "url": "/design/human-interface-guidelines/charting-data"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/collaboration-and-sharing": {"abstract": [{"text": "Great collaboration and sharing experiences are simple and responsive, letting people engage with the content while communicating effectively with others.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/collaboration-and-sharing", "images": [{"identifier": "collaboration-and-sharing.svg", "type": "icon"}, {"identifier": "patterns-collaboration-and-sharing-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Collaboration and sharing", "type": "topic", "url": "/design/human-interface-guidelines/collaboration-and-sharing"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/drag-and-drop": {"abstract": [{"text": "Using drag and drop, people can move or duplicate selected photos, text, and other content by dragging the selection from one location to another.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/drag-and-drop", "images": [{"identifier": "drag-and-drop.svg", "type": "icon"}, {"identifier": "patterns-drag-and-drop-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Drag and drop", "type": "topic", "url": "/design/human-interface-guidelines/drag-and-drop"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/entering-data": {"abstract": [{"text": "When you need information from people, design ways that make it easy for them to provide it without making mistakes.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/entering-data", "images": [{"identifier": "data-entry.svg", "type": "icon"}, {"identifier": "patterns-entering-data-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Entering data", "type": "topic", "url": "/design/human-interface-guidelines/entering-data"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/feedback": {"abstract": [{"text": "Feedback helps people know what\u2019s happening, discover what they can do next, understand the results of actions, and avoid mistakes.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/feedback", "images": [{"identifier": "feedback.svg", "type": "icon"}, {"identifier": "patterns-feedback-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Feedback", "type": "topic", "url": "/design/human-interface-guidelines/feedback"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/file-management": {"abstract": [{"text": "Some apps can support documents and files that people expect to manage throughout the system.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/file-management", "images": [{"identifier": "file-management.svg", "type": "icon"}, {"identifier": "patterns-file-management-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "File management", "type": "topic", "url": "/design/human-interface-guidelines/file-management"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/going-full-screen": {"abstract": [{"text": "iPhone, iPad, and Mac offer full-screen modes that let people expand a window to fill the screen, hiding system controls and providing a distraction-free environment.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/going-full-screen", "images": [{"identifier": "going-full-screen.svg", "type": "icon"}, {"identifier": "patterns-going-full-screen-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Going full screen", "type": "topic", "url": "/design/human-interface-guidelines/going-full-screen"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/launching": {"abstract": [{"text": "A streamlined launch experience helps people start using your app or game immediately.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/launching", "images": [{"identifier": "launching.svg", "type": "icon"}, {"identifier": "patterns-launching-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Launching", "type": "topic", "url": "/design/human-interface-guidelines/launching"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/live-viewing-apps": {"abstract": [{"text": "As you design a live-viewing app, prioritize the content and create fun, fluid interactions that encourage immersion in the live-viewing experience.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/live-viewing-apps", "images": [{"identifier": "live-viewing-apps.svg", "type": "icon"}, {"identifier": "patterns-live-viewing-apps-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Live-viewing apps", "type": "topic", "url": "/design/human-interface-guidelines/live-viewing-apps"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/loading": {"abstract": [{"text": "The best content-loading experience finishes before people become aware of it.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/loading", "images": [{"identifier": "loading.svg", "type": "icon"}, {"identifier": "patterns-loading-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Loading", "type": "topic", "url": "/design/human-interface-guidelines/loading"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/managing-accounts": {"abstract": [{"text": "When it doesn\u2019t create an unnecessary barrier to your experience, an account can be a convenient way for people to access their content and track personal details.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/managing-accounts", "images": [{"identifier": "managing-accounts.svg", "type": "icon"}, {"identifier": "patterns-managing-accounts-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Managing accounts", "type": "topic", "url": "/design/human-interface-guidelines/managing-accounts"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/managing-notifications": {"abstract": [{"text": "Notifications can give people timely and important information, whether the device is locked or in use.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/managing-notifications", "images": [{"identifier": "managing-notifications.svg", "type": "icon"}, {"identifier": "patterns-managing-notifications-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Managing notifications", "type": "topic", "url": "/design/human-interface-guidelines/managing-notifications"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/modality": {"abstract": [{"text": "Modality is a design technique that presents content in a separate, dedicated mode that prevents interaction with the parent view and requires an explicit action to dismiss.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/modality", "images": [{"identifier": "modality.svg", "type": "icon"}, {"identifier": "patterns-modality-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Modality", "type": "topic", "url": "/design/human-interface-guidelines/modality"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/multitasking": {"abstract": [{"text": "Multitasking lets people switch quickly from one app to another, performing tasks in each.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/multitasking", "images": [{"identifier": "multitasking.svg", "type": "icon"}, {"identifier": "patterns-multitasking-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Multitasking", "type": "topic", "url": "/design/human-interface-guidelines/multitasking"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/offering-help": {"abstract": [{"text": "Although the most effective experiences are approachable and intuitive, you can provide contextual help when necessary.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/offering-help", "images": [{"identifier": "help.svg", "type": "icon"}, {"identifier": "patterns-offering-help-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Offering help", "type": "topic", "url": "/design/human-interface-guidelines/offering-help"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/onboarding": {"abstract": [{"text": "Onboarding can help people get a quick start using your app or game.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/onboarding", "images": [{"identifier": "onboarding.svg", "type": "icon"}, {"identifier": "patterns-onboarding-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Onboarding", "type": "topic", "url": "/design/human-interface-guidelines/onboarding"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/playing-audio": {"abstract": [{"text": "People expect rich audio experiences that automatically adjust when the context changes on the device.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/playing-audio", "images": [{"identifier": "playing-audio.svg", "type": "icon"}, {"identifier": "patterns-playing-audio-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Playing audio", "type": "topic", "url": "/design/human-interface-guidelines/playing-audio"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/playing-haptics": {"abstract": [{"text": "Playing haptics can engage people\u2019s sense of touch and bring their familiarity with the physical world into your app or game.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/playing-haptics", "images": [{"identifier": "playing-haptics.svg", "type": "icon"}, {"identifier": "patterns-playing-haptics-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Playing haptics", "type": "topic", "url": "/design/human-interface-guidelines/playing-haptics"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/playing-video": {"abstract": [{"text": "People expect to enjoy rich video experiences on their devices, regardless of the app or game they\u2019re using.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/playing-video", "images": [{"identifier": "playing-video.svg", "type": "icon"}, {"identifier": "patterns-playing-video-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Playing video", "type": "topic", "url": "/design/human-interface-guidelines/playing-video"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/printing": {"abstract": [{"text": "An iOS, iPadOS, macOS, or visionOS app can integrate system-provided print functionality when it makes sense, presenting custom printer- and document-specific options if necessary.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/printing", "images": [{"identifier": "printing.svg", "type": "icon"}, {"identifier": "patterns-printing-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Printing", "type": "topic", "url": "/design/human-interface-guidelines/printing"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/ratings-and-reviews": {"abstract": [{"text": "People often view the ratings and reviews for an app or game before they download it.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/ratings-and-reviews", "images": [{"identifier": "ratings-and-reviews.svg", "type": "icon"}, {"identifier": "patterns-ratings-and-reviews-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Ratings and reviews", "type": "topic", "url": "/design/human-interface-guidelines/ratings-and-reviews"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/searching": {"abstract": [{"text": "People use various search techniques to find content on their device, within an app, and within a document or file.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/searching", "images": [{"identifier": "searching.svg", "type": "icon"}, {"identifier": "patterns-searching-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Searching", "type": "topic", "url": "/design/human-interface-guidelines/searching"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/settings": {"abstract": [{"text": "People expect apps and games to just work, but they also appreciate having ways to customize the experience to fit their needs.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/settings", "images": [{"identifier": "settings.svg", "type": "icon"}, {"identifier": "patterns-settings-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Settings", "type": "topic", "url": "/design/human-interface-guidelines/settings"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/undo-and-redo": {"abstract": [{"text": "Undo and redo gives people easy ways to reverse many types of actions, which can also help people explore and experiment safely as they learn a new interface or task.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/undo-and-redo", "images": [{"identifier": "undo-and-redo.svg", "type": "icon"}, {"identifier": "patterns-undo-and-redo-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Undo and redo", "type": "topic", "url": "/design/human-interface-guidelines/undo-and-redo"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/workouts": {"abstract": [{"text": "A great workout or fitness experience encourages people to engage with their current activity and helps them track their progress on their devices.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/workouts", "images": [{"identifier": "workouts.svg", "type": "icon"}, {"identifier": "patterns-workouts-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Workouts", "type": "topic", "url": "/design/human-interface-guidelines/workouts"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "drag-and-drop.svg": {"alt": "An icon of two overlapping squares containing an arrow pointing to the upper-left that suggests a transition to a new destination.", "identifier": "drag-and-drop.svg", "type": "image", "variants": [{"svgID": "drag-and-drop", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/drag-and-drop.svg"}]}, "feedback.svg": {"alt": "An icon of a pointer surrounded by a circular set of short lines that suggests a response to a mouse click.", "identifier": "feedback.svg", "type":