delines/components": {"abstract": [{"text": "Learn how to use and customize system-defined components to give people a familiar and consistent experience.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/components", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "components.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Components", "type": "topic", "url": "/design/human-interface-guidelines/components"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/eyes": {"abstract": [{"text": "In visionOS, people look at a virtual object to identify it as a target they can interact with.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/eyes", "images": [{"identifier": "eyes.svg", "type": "icon"}, {"identifier": "inputs-eyes-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Eyes", "type": "topic", "url": "/design/human-interface-guidelines/eyes"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/layout": {"abstract": [{"text": "A consistent layout that adapts across display sizes, orientations, and multitasking configurations helps people understand and enjoy your app or game on all their devices.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/layout", "images": [{"identifier": "layout.svg", "type": "icon"}, {"identifier": "foundations-layout-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Layout", "type": "topic", "url": "/design/human-interface-guidelines/layout"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/materials#visionOS": {"abstract": [], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/materials#visionOS", "kind": "section", "title": "visionOS", "type": "topic", "url": "/design/human-interface-guidelines/materials#visionOS"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/menus-and-actions": {"abstract": [], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/menus-and-actions", "images": [{"identifier": "menus-and-actions.svg", "type": "icon"}, {"identifier": "components-menus-and-actions-thumbnail.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Menus and actions", "type": "topic", "url": "/design/human-interface-guidelines/menus-and-actions"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/tab-bars": {"abstract": [{"text": "A tab bar lets people navigate between top-level sections of your app.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/tab-bars", "images": [{"identifier": "components-tab-bars-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Tab bars", "type": "topic", "url": "/design/human-interface-guidelines/tab-bars"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/toolbars": {"abstract": [{"text": "A toolbar provides convenient access to frequently used commands, controls, navigation, and search.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/toolbars", "images": [{"identifier": "components-toolbars-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Toolbars", "type": "topic", "url": "/design/human-interface-guidelines/toolbars"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/SwiftUI/TabView": {"abstract": [{"text": "A view that switches between multiple child views using interactive user", "type": "text"}, {"text": " ", "type": "text"}, {"text": "interface elements.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "struct"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "TabView"}], "identifier": "doc://com.apple.documentation/documentation/SwiftUI/TabView", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "TabView"}], "role": "symbol", "title": "TabView", "type": "topic", "url": "/documentation/swiftui/tabview"}, "doc://com.apple.documentation/documentation/SwiftUI/Toolbars": {"abstract": [{"text": "Provide immediate access to frequently used commands and controls.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/SwiftUI/Toolbars", "kind": "article", "role": "collectionGroup", "title": "Toolbars", "type": "topic", "url": "/documentation/swiftui/toolbars"}, "doc://com.apple.documentation/documentation/SwiftUI/View/ornament(visibility:attachmentAnchor:contentAlignment:ornament:)": {"abstract": [{"text": "Presents an ornament.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "func"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "ornament"}, {"kind": "text", "text": "<"}, {"kind": "genericParameter", "text": "Content"}, {"kind": "text", "text": ">("}, {"kind": "externalParam", "text": "visibility"}, {"kind": "text", "text": ": "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:7SwiftUI10VisibilityO", "text": "Visibility"}, {"kind": "text", "text": ", "}, {"kind": "externalParam", "text": "attachmentAnchor"}, {"kind": "text", "text": ": "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:7SwiftUI24OrnamentAttachmentAnchorV", "text": "OrnamentAttachmentAnchor"}, {"kind": "text", "text": ", "}, {"kind": "externalParam", "text": "contentAlignment"}, {"kind": "text", "text": ": "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:7SwiftUI11Alignment3DV", "text": "Alignment3D"}, {"kind": "text", "text": ", "}, {"kind": "externalParam", "text": "ornament"}, {"kind": "text", "text": ": () -> "}, {"kind": "typeIdentifier", "text": "Content"}, {"kind": "text", "text": ") -> "}, {"kind": "keyword", "text": "some"}, {"kind": "text", "text": " "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:7SwiftUI4ViewP", "text": "View"}, {"kind": "text", "text": "\n"}], "identifier": "doc://com.apple.documentation/documentation/SwiftUI/View/ornament(visibility:attachmentAnchor:contentAlignment:ornament:)", "kind": "symbol", "role": "symbol", "title": "ornament(visibility:attachmentAnchor:contentAlignment:ornament:)", "type": "topic", "url": "/documentation/swiftui/view/ornament(visibility:attachmentanchor:contentalignment:ornament:)"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "doc://com.apple.documentation/videos/play/wwdc2023/10076": {"abstract": [{"text": "Learn how to design great interfaces for spatial computing apps. We\u2019ll share how your existing screen-based knowledge easily translates into creating great experiences for visionOS. Explore guidelines for UI components, materials, and typography and find out how you can design experiences that are familiar, legible, and easy to use.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2023/10076", "images": [{"identifier": "38E4EE32-29B5-4478-B8B6-35B8ACA67B16", "type": "card"}], "kind": "article", "role": "article", "title": "Design for spatial user interfaces", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2023/10076"}, "eyes.svg": {"alt": "An icon of a human eye.", "identifier": "eyes.svg", "type": "image", "variants": [{"svgID": "Design-Spec", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/eyes.svg"}]}, "foundations-layout-thumbnail.png": {"alt": "A sketch of a small rectangle in the upper-left quadrant of a larger rectangle, suggesting the position of a user interface element within a window. The image is overlaid with rectangular and circular grid lines and is tinted yellow to subtly reflect the yellow in the original six-color Apple logo.", "identifier": "foundations-layout-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/foundations-layout-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/foundations-layout-thumbnail~dark@2x.png"}]}, "human-interface-guidelines-page-image-card.png": {"alt": "An illustration of several Liquid Glass components such as toggles, sliders, and buttons, atop a neutral background. The transparent components cast shadows on the background and allow their colored elements, like a blue slider track and a green toggle backing, to show through, highlighting the Liquid Glass material's lensing effect.", "identifier": "human-interface-guidelines-page-image-card.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/human-interface-guidelines-page-image-card@2x.png"}]}, "inputs-eyes-thumbnail.png": {"alt": "A sketch of a human eye. The image is tinted purple to subtly reflect the purple in the original six-color Apple logo.", "identifier": "inputs-eyes-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/inputs-eyes-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/inputs-eyes-thumbnail~dark@2x.png"}]}, "layout.svg": {"alt": "An icon of a small rectangle in the upper-left quadrant of a larger rectangle that suggests the position of a user interface element within a window.", "identifier": "layout.svg", "type": "image", "variants": [{"svgID": "layout", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/layout.svg"}]}, "menus-and-actions.svg": {"alt": "An icon of a menu with a selected menu item, suggesting menus and actions.", "identifier": "menus-and-actions.svg", "type": "image", "variants": [{"svgID": "menus-and-actions", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/menus-and-actions.svg"}]}, "overview.svg": {"alt": "An icon of a grid comprised of four squares.", "identifier": "overview.svg", "type": "image", "variants": [{"svgID": "overview", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/overview.svg"}]}}}