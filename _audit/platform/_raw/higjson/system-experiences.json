mages/com.apple.HIG/components-widgets-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/components-widgets-thumbnail~dark@2x.png"}]}, "components.png": {"alt": "", "identifier": "components.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/components@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/components~dark@2x.png"}]}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/app-shortcuts": {"abstract": [{"text": "An App Shortcut gives people access to your app\u2019s key functions or content throughout the system.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/app-shortcuts", "images": [{"identifier": "components-app-shortcuts-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "App Shortcuts", "type": "topic", "url": "/design/human-interface-guidelines/app-shortcuts"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/complications": {"abstract": [{"text": "A complication displays timely, relevant information on the watch face, where people can view it each time they raise their wrist.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/complications", "images": [{"identifier": "components-complications-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Complications", "type": "topic", "url": "/design/human-interface-guidelines/complications"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/components": {"abstract": [{"text": "Learn how to use and customize system-defined components to give people a familiar and consistent experience.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/components", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "components.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Components", "type": "topic", "url": "/design/human-interface-guidelines/components"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/controls": {"abstract": [{"text": "A control provides quick access to a feature of your app from Control Center, the Lock Screen, or the Action button.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/controls", "images": [{"identifier": "components-controls-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Controls", "type": "topic", "url": "/design/human-interface-guidelines/controls"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/live-activities": {"abstract": [{"text": "A Live Activity lets people track the progress of an activity, event, or task at a glance.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/live-activities", "images": [{"identifier": "components-live-activities-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Live Activities", "type": "topic", "url": "/design/human-interface-guidelines/live-activities"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/notifications": {"abstract": [{"text": "A notification gives people timely, high-value information they can understand at a glance.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/notifications", "images": [{"identifier": "components-notifications-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Notifications", "type": "topic", "url": "/design/human-interface-guidelines/notifications"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/snippets": {"abstract": [{"text": "When someone performs a task with Siri or an App Shortcut, a snippet shows the result or asks for confirmation.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/snippets", "images": [{"identifier": "components-snippets-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Snippets", "type": "topic", "url": "/design/human-interface-guidelines/snippets"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/status-bars": {"abstract": [{"text": "A status bar appears along the upper edge of the screen and displays information about the device\u2019s current state, like the time, cellular carrier, and battery level.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/status-bars", "images": [{"identifier": "components-status-bars-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Status bars", "type": "topic", "url": "/design/human-interface-guidelines/status-bars"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/top-shelf": {"abstract": [{"text": "The Apple TV Home Screen provides an area called Top Shelf, which showcases your content in a rich, engaging way while also giving people access to their favorite apps in the Dock.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/top-shelf", "images": [{"identifier": "components-top-shelf-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Top Shelf", "type": "topic", "url": "/design/human-interface-guidelines/top-shelf"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/watch-faces": {"abstract": [{"text": "A watch face is a view that people choose as their primary view in watchOS.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/watch-faces", "images": [{"identifier": "components-watch-faces-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Watch faces", "type": "topic", "url": "/design/human-interface-guidelines/watch-faces"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/widgets": {"abstract": [{"text": "A widget provides quick access to essential information and focused interactions from your app or game in additional contexts.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/widgets", "images": [{"identifier": "components-widgets-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Widgets", "type": "topic", "url": "/design/human-interface-guidelines/widgets"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "human-interface-guidelines-page-image-card.png": {"alt": "An illustration of several Liquid Glass components such as toggles, sliders, and buttons, atop a neutral background. The transparent components cast shadows on the background and allow their colored elements, like a blue slider track and a green toggle backing, to show through, highlighting the Liquid Glass material's lensing effect.", "identifier": "human-interface-guidelines-page-image-card.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/human-interface-guidelines-page-image-card@2x.png"}]}, "overview.svg": {"alt": "An icon of a grid comprised of four squares.", "identifier": "overview.svg", "type": "image", "variants": [{"svgID": "overview", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/overview.svg"}]}, "system.svg": {"alt": "An icon consisting of an iPad frame overlapping a Mac, suggesting system experiences.", "identifier": "system.svg", "type": "image", "variants": [{"svgID": "system", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/system.svg"}]}}}