{"abstract": [{"text": "People value the power, mobility, and flexibility of iPad as they enjoy media, play games, perform detailed productivity tasks, and bring their creations to life.", "type": "text"}], "hierarchy": {"paths": [["doc://com.apple.documentation/documentation/technologies", "doc://com.apple.HIG/design/human-interface-guidelines", "doc://com.apple.HIG/design/Human-Interface-Guidelines/getting-started"]]}, "identifier": {"interfaceLanguage": "swift", "url": "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-ipados"}, "kind": "article", "legalNotices": {"copyright": "Copyright &copy; 2026 Apple Inc. All rights reserved.", "privacyPolicy": "https://www.apple.com/privacy/privacy-policy", "termsOfUse": "https://www.apple.com/legal/internet-services/terms/site.html"}, "metadata": {"availableLanguages": ["en-US", "zh-CN", "ja-JP", "ko-KR"], "images": [{"identifier": "ipados.svg", "type": "icon"}, {"identifier": "platforms-designing-for-ipados-thumbnail.png", "type": "card"}], "role": "article", "title": "Designing for iPadOS"}, "primaryContentSections": [{"content": [{"inlineContent": [{"identifier": "platforms-iPadOS-intro.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"text": "As you begin designing your app or game for iPad, start by understanding the following fundamental device characteristics and patterns that distinguish the iPadOS experience. Using these characteristics and patterns to inform your design decisions can help you provide an app or game that iPad users appreciate.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Display.", "type": "text"}], "type": "strong"}, {"text": " iPad has a large, high-resolution display.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Ergonomics.", "type": "text"}], "type": "strong"}, {"text": " People often hold their iPad while using it, but they might also set it on a surface or place it on a stand. Positioning the device in different ways can change the viewing distance, although people are typically within about 3 feet of the device as they interact with it.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Inputs.", "type": "text"}], "type": "strong"}, {"text": " People can interact with iPad using Multi-Touch ", "type": "text"}, {"identifier": "https://developer.apple.com/design/human-interface-guidelines/gestures", "isActive": true, "type": "reference"}, {"text": " and ", "type": "text"}, {"identifier": "https://developer.apple.com/design/human-interface-guidelines/virtual-keyboards", "isActive": true, "type": "reference"}, {"text": ", an attached ", "type": "text"}, {"identifier": "https://developer.apple.com/design/human-interface-guidelines/keyboards", "isActive": true, "type": "reference"}, {"text": " or ", "type": "text"}, {"identifier": "https://developer.apple.com/design/human-interface-guidelines/pointing-devices", "isActive": true, "type": "reference"}, {"text": ", ", "type": "text"}, {"identifier": "https://developer.apple.com/design/human-interface-guidelines/apple-pencil-and-scribble", "isActive": true, "type": "reference"}, {"text": ", or ", "type": "text"}, {"identifier": "https://developer.apple.com/design/human-interface-guidelines/siri", "isActive": true, "type": "reference"}, {"text": ", and they often combine multiple input modes.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "App interactions.", "type": "text"}], "type": "strong"}, {"text": " Sometimes, people perform a few quick actions on their iPad. At other times, they spend hours immersed in games, media, content creation, or productivity tasks. People frequently have multiple apps open at the same time, and they appreciate viewing more than one app onscreen at once and taking advantage of inter-app capabilities like drag and drop.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "System features.", "type": "text"}], "type": "strong"}, {"text": " iPadOS provides several features that help people interact with the system and their apps in familiar, consistent ways.", "type": "text"}], "type": "paragraph"}, {"items": [{"content": [{"inlineContent": [{"identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/multitasking", "isActive": true, "type": "reference"}], "type": "paragraph"}]}, {"content": [{"inlineContent": [{"identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/widgets", "isActive": true, "type": "reference"}], "type": "paragraph"}]}, {"content": [{"inlineContent": [{"identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/drag-and-drop", "isActive": true, "type": "reference"}], "type": "paragraph"}]}], "type": "unorderedList"}, {"anchor": "Best-practices", "level": 2, "text": "Best practices", "type": "heading"}, {"inlineContent": [{"text": "Great iPad experiences integrate the platform and device capabilities that people value most. To help your experience feel at home in iPadOS, prioritize the following ways to incorporate these features and capabilities.", "type": "text"}], "type": "paragraph"}, {"items": [{"content": [{"inlineContent": [{"text": "Take advantage of the large display to elevate the content people care about, minimizing modal interfaces and full-screen transitions, and positioning onscreen controls where they\u2019re easy to reach, but not in the way.", "type": "text"}], "type": "paragraph"}]}, {"content": [{"inlineContent": [{"text": "Use viewing distance and input mode to help you determine the size and density of the onscreen content you display.", "type": "text"}], "type": "paragraph"}]}, {"content": [{"inlineContent": [{"text": "Let people use Multi-Touch gestures, a physical keyboard or trackpad, or Apple Pencil, and consider supporting unique interactions that combine multiple input modes.", "type": "text"}], "type": "paragraph"}]}, {"content": [{"inlineContent": [{"text": "Adapt seamlessly to appearance changes \u2014 like device orientation, multitasking modes, Dark Mode, and Dynamic Type \u2014 and transition effortlessly to running in macOS, letting people choose the configurations that work best for them.", "type": "text"}], "type": "paragraph"}]}], "type": "unorderedList"}, {"anchor": "Resources", "level": 2, "text": "Resources", "type": "heading"}, {"anchor": "Related", "level": 4, "text": "Related", "type": "heading"}, {"inlineContent": [{"identifier": "https://developer.apple.com/design/resources/#ios-apps", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"anchor": "Developer-documentation", "level": 4, "text": "Developer documentation", "type": "heading"}, {"inlineContent": [{"identifier": "https://developer.apple.com/ipados/get-started/", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"anchor": "Videos", "level": 4, "text": "Videos", "type": "heading"}, {"items": ["doc://com.apple.documentation/videos/play/wwdc2025/208", "doc://com.apple.documentation/videos/play/wwdc2025/219", "doc://com.apple.documentation/videos/play/wwdc2025/356"], "style": "compactGrid", "type": "links"}], "kind": "content"}], "schemaVersion": {"major": 0, "minor": 3, "patch": 0}, "sections": [], "topicSectionsStyle": "compactGrid", "references": {"1AAA030E-2ECA-47D8-AE09-6D7B72A840F6": {"alt": null, "identifier": "1AAA030E-2ECA-47D8-AE09-6D7B72A840F6", "type": "image", "variants": [{"traits": ["1x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/1AAA030E-2ECA-47D8-AE09-6D7B72A840F6/10044_wide_250x141_1x.jpg"}, {"traits": ["2x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/1AAA030E-2ECA-47D8-AE09-6D7B72A840F6/10044_wide_250x141_2x.jpg"}, {"traits": ["3x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/1AAA030E-2ECA-47D8-AE09-6D7B72A840F6/10044_wide_250x141_3x.jpg"}]}, "5CD0E251-424E-490F-89CF-1E64848209A6": {"alt": null, "identifier": "5CD0E251-424E-490F-89CF-1E64848209A6", "type": "image", "variants": [{"traits": ["1x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/5CD0E251-424E-490F-89CF-1E64848209A6/9910_wide_250x141_1x.jpg"}, {"traits": ["2x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/5CD0E251-424E-490F-89CF-1E64848209A6/9910_wide_250x141_2x.jpg"}, {"traits": ["3x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/5CD0E251-424E-490F-89CF-1E64848209A6/9910_wide_250x141_3x.jpg"}]}, "873F40BE-101A-4C0D-99F0-F5C7CE7B47A3": {"alt": null, "identifier": "873F40BE-101A-4C0D-99F0-F5C7CE7B47A3", "type": "image", "variants": [{"traits": ["1x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/873F40BE-101A-4C0D-99F0-F5C7CE7B47A3/10046_wide_250x141_1x.jpg"}, {"traits": ["2x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/873F40BE-101A-4C0D-99F0-F5C7CE7B47A3/10046_wide_250x141_2x.jpg"}, {"traits": ["3x"], "url": "https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/873F40BE-101A-4C0D-99F0-F5C7CE7B47A3/10046_wide_250x141_3x.jpg"}]}, "components-widgets-thumbnail.png": {"alt": "A stylized representation of a set of different-sized widgets on an iPad Home Screen. The image is tinted red to subtly reflect the red in the original six-color Apple logo.", "identifier": "components-widgets-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/components-widgets-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/components-widgets-thumbnail~dark@2x.png"}]}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/drag-and-drop": {"abstract": [{"text": "Using drag and drop, people can move or duplicate selected photos, text, and other content by dragging the selection from one location to another.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/drag-and-drop", "images": [{"identifier": "drag-and-drop.svg", "type": "icon"}, {"identifier": "patterns-drag-and-drop-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Drag and drop", "type": "topic", "url": "/design/human-interface-guidelines/drag-and-drop"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/getting-started": {"abstract": [{"text": "Create an app or game that feels at home on every platform you support.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/getting-started", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "platforms.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Getting started", "type": "topic", "url": "/design/human-interface-guidelines/getting-started"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/multitasking": {"abstract": [{"text": "Multitasking lets people switch quickly from one app to another, performing tasks in each.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/multitasking", "images": [{"identifier": "multitasking.svg", "type": "icon"}, {"identifier": "patterns-multitasking-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Multitasking", "type": "topic", "url": "/design/human-interface-guidelines/multitasking"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/widgets": {"abstract": [{"text": "A widget provides quick access to essential information and focused interactions from your app or game in additional contexts.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/widgets", "images": [{"identifier": "components-widgets-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Widgets", "type": "topic", "url": "/design/human-interface-guidelines/widgets"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "doc://com.apple.documentation/videos/play/wwdc2025/208": {"abstract": [{"text": "Make your app look and feel great on iPadOS. Learn best practices for designing a responsive layout for resizable app windows. Get familiar with window controls and explore the best ways to accommodate them. Discover the building blocks of a great menu bar. And meet the new pointer and its updated effects.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2025/208", "images": [{"identifier": "873F40BE-101A-4C0D-99F0-F5C7CE7B47A3", "type": "card"}], "kind": "article", "role": "article", "title": "Elevate the design of your iPad app", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2025/208"}, "doc://com.apple.documentation/videos/play/wwdc2025/219": {"abstract": [{"text": "Liquid Glass unifies Apple platform design language while providing a more dynamic and expressive user experience. Get to know the design principles of Liquid Glass, explore its core optical and physical properties, and learn where to use it and why.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2025/219", "images": [{"identifier": "5CD0E251-424E-490F-89CF-1E64848209A6", "type": "card"}], "kind": "article", "role": "article", "title": "Meet Liquid Glass", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2025/219"}, "doc://com.apple.documentation/videos/play/wwdc2025/356": {"abstract": [{"text": "Dive deeper into the new design system to explore key changes to visual design, information architecture, and core system components. Learn how the system reshapes the relationship between interface and content, enabling you to create designs that are dynamic, harmonious, and consistent across devices, screen sizes, and input modes.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2025/356", "images": [{"identifier": "1AAA030E-2ECA-47D8-AE09-6D7B72A840F6", "type": "card"}], "kind": "article", "role": "article", "title": "Get to know the new design system", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2025/356"}, "drag-and-drop.svg": {"alt": "An icon of two overlapping squares containing an arrow pointing to the upper-left that suggests a transition to a new destination.", "identifier": "drag-and-drop.svg", "type": "image", "variants": [{"svgID": "drag-and-drop", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/drag-and-drop.svg"}]}, "https://developer.apple.com/design/human-interface-guidelines/apple-pencil-and-scribble": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/apple-pencil-and-scribble", "title": "Apple Pencil", "titleInlineContent": [{"text": "Apple Pencil", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/apple-pencil-and-scribble"}, "https://developer.apple.com/design/human-interface-guidelines/gestures": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/gestures", "title": "gestures", "titleInlineContent": [{"text": "gestures", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/gestures"}, "https://developer.apple.com/design/human-interface-guidelines/keyboards": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/keyboards", "title": "keyboard", "titleInlineContent": [{"text": "keyboard", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/keyboards"}, "https://developer.apple.com/design/human-interface-guidelines/pointing-devices": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/pointing-devices", "title": "pointing device", "titleInlineContent": [{"text": "pointing device", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/pointing-devices"}, "https://developer.apple.com/design/human-interface-guidelines/siri": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/siri", "title": "voice", "titleInlineContent": [{"text": "voice", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/siri"}, "https://developer.apple.com/design/human-interface-guidelines/virtual-keyboards": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/virtual-keyboards", "title": "virtual keyboards", "titleInlineContent": [{"text": "virtual keyboards", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/virtual-keyboards"}, "https://developer.apple.com/design/resources/#ios-apps": {"identifier": "https://developer.apple.com/design/resources/#ios-apps", "title": "Apple Design Resources", "titleInlineContent": [{"text": "Apple Design Resources", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/resources/#ios-apps"}, "https://developer.apple.com/ipados/get-started/": {"identifier": "https://developer.apple.com/ipados/get-started/", "title": "iPadOS Pathway", "titleInlineContent": [{"text": "iPadOS Pathway", "type": "text"}], "type": "link", "url": "https://developer.apple.com/ipados/get-started/"}, "human-interface-guidelines-page-image-card.png": {"alt": "An illustration of several Liquid Glass components such as toggles, sliders, and buttons, atop a neutral background. The transparent components cast shadows on the background and allow their colored elements, like a blue slider track and a green toggle backing, to show through, highlighting the Liquid Glass material's lensing effect.", "identifier": "human-interface-guidelines-page-image-card.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/human-interface-guidelines-page-image-card@2x.png"}]}, "ipados.svg": {"alt": "An icon of an iPad frame.", "identifier": "ipados.svg", "type": "image", "variants": [{"svgID": "ipados", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/ipados.svg"}]}, "multitasking.svg": {"alt": "An icon of two side-by-side windows in a split view arrangement that suggests multitasking.", "identifier": "multitasking.svg", "type": "image", "variants": [{"svgID": "multitasking", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/multitasking.svg"}]}, "overview.svg": {"alt": "An icon of a grid comprised of four squares.", "identifier": "overview.svg", "type": "image", "variants": [{"svgID": "overview", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/overview.svg"}]}, "patterns-drag-and-drop-thumbnail.png": {"alt": "A sketch of two overlapping squares containing an arrow pointing to the upper-left, suggesting a transition to a new destination. The image is tinted orange to subtly reflect the orange in the original six-color Apple logo.", "identifier": "patterns-drag-and-drop-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/patterns-drag-and-drop-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/patterns-drag-and-drop-thumbnail~dark@2x.png"}]}, "patterns-multitasking-thumbnail.png": {"alt": "A sketch of two side-by-side windows in a split view arrangement, suggesting multitasking. The image is tinted orange to subtly reflect the orange in the original six-color Apple logo.", "identifier": "patterns-multitasking-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/patterns-multitasking-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/patterns-multitasking-thumbnail~dark@2x.png"}]}, "platforms-designing-for-ipados-thumbnail.png": {"alt": "A stylized representation of an iPad frame. The image is tinted green to subtly reflect the green in the original six-color Apple logo.", "identifier": "platforms-designing-for-ipados-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/platforms-designing-for-ipados-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/platforms-designing-for-ipados-thumbnail~dark@2x.png"}]}, "platforms-iPadOS-intro.png": {"alt": "A stylized representation of an iPad frame shown on top of a grid. The image is overlaid with rectangular and circular grid lines and is tinted green to subtly reflect the green in the original six-color Apple logo.", "identifier": "platforms-iPadOS-intro.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/platforms-iPadOS-intro@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/platforms-iPadOS-intro~dark@2x.png"}]}, "platforms.png": {"alt": "", "identifier": "platforms.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/platforms@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/platforms~dark@2x.png"}]}}}