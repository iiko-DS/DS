ogo.", "identifier": "components-home-screen-quick-actions-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/components-home-screen-quick-actions-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/components-home-screen-quick-actions-thumbnail~dark@2x.png"}]}, "components-widgets-thumbnail.png": {"alt": "A stylized representation of a set of different-sized widgets on an iPad Home Screen. The image is tinted red to subtly reflect the red in the original six-color Apple logo.", "identifier": "components-widgets-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/components-widgets-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/components-widgets-thumbnail~dark@2x.png"}]}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/activity-views": {"abstract": [{"text": "An activity view \u2014 often called a ", "type": "text"}, {"inlineContent": [{"text": "share sheet", "type": "text"}], "type": "emphasis"}, {"text": " \u2014 presents a range of tasks that people can perform in the current context.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/activity-views", "images": [{"identifier": "components-activity-views-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Activity views", "type": "topic", "url": "/design/human-interface-guidelines/activity-views"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/getting-started": {"abstract": [{"text": "Create an app or game that feels at home on every platform you support.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/getting-started", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "platforms.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Getting started", "type": "topic", "url": "/design/human-interface-guidelines/getting-started"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/home-screen-quick-actions": {"abstract": [{"text": "Home Screen quick actions give people a way to perform app-specific actions from the Home Screen.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/home-screen-quick-actions", "images": [{"identifier": "components-home-screen-quick-actions-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Home Screen quick actions", "type": "topic", "url": "/design/human-interface-guidelines/home-screen-quick-actions"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/widgets": {"abstract": [{"text": "A widget provides quick access to essential information and focused interactions from your app or game in additional contexts.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/widgets", "images": [{"identifier": "components-widgets-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Widgets", "type": "topic", "url": "/design/human-interface-guidelines/widgets"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "doc://com.apple.documentation/videos/play/wwdc2025/219": {"abstract": [{"text": "Liquid Glass unifies Apple platform design language while providing a more dynamic and expressive user experience. Get to know the design principles of Liquid Glass, explore its core optical and physical properties, and learn where to use it and why.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2025/219", "images": [{"identifier": "5CD0E251-424E-490F-89CF-1E64848209A6", "type": "card"}], "kind": "article", "role": "article", "title": "Meet Liquid Glass", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2025/219"}, "doc://com.apple.documentation/videos/play/wwdc2025/356": {"abstract": [{"text": "Dive deeper into the new design system to explore key changes to visual design, information architecture, and core system components. Learn how the system reshapes the relationship between interface and content, enabling you to create designs that are dynamic, harmonious, and consistent across devices, screen sizes, and input modes.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2025/356", "images": [{"identifier": "1AAA030E-2ECA-47D8-AE09-6D7B72A840F6", "type": "card"}], "kind": "article", "role": "article", "title": "Get to know the new design system", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2025/356"}, "https://developer.apple.com/design/human-interface-guidelines/gestures": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/gestures", "title": "gestures", "titleInlineContent": [{"text": "gestures", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/gestures"}, "https://developer.apple.com/design/human-interface-guidelines/gyro-and-accelerometer": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/gyro-and-accelerometer", "title": "gyroscope and accelerometer", "titleInlineContent": [{"text": "gyroscope and accelerometer", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/gyro-and-accelerometer"}, "https://developer.apple.com/design/human-interface-guidelines/privacy": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/privacy", "title": "personal data", "titleInlineContent": [{"text": "personal data", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/privacy"}, "https://developer.apple.com/design/human-interface-guidelines/searching": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/searching", "title": "Spotlight", "titleInlineContent": [{"text": "Spotlight", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/searching"}, "https://developer.apple.com/design/human-interface-guidelines/siri": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/siri", "title": "voice", "titleInlineContent": [{"text": "voice", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/siri"}, "https://developer.apple.com/design/human-interface-guidelines/siri#Shortcuts-and-suggestions": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/siri#Shortcuts-and-suggestions", "title": "Shortcuts", "titleInlineContent": [{"text": "Shortcuts", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/siri#Shortcuts-and-suggestions"}, "https://developer.apple.com/design/human-interface-guidelines/spatial-interactions": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/spatial-interactions", "title": "spatial interactions", "titleInlineContent": [{"text": "spatial interactions", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/spatial-interactions"}, "https://developer.apple.com/design/human-interface-guidelines/virtual-keyboards": {"identifier": "https://developer.apple.com/design/human-interface-guidelines/virtual-keyboards", "title": "virtual keyboards", "titleInlineContent": [{"text": "virtual keyboards", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/human-interface-guidelines/virtual-keyboards"}, "https://developer.apple.com/design/resources/#ios-apps": {"identifier": "https://developer.apple.com/design/resources/#ios-apps", "title": "Apple Design Resources", "titleInlineContent": [{"text": "Apple Design Resources", "type": "text"}], "type": "link", "url": "https://developer.apple.com/design/resources/#ios-apps"}, "https://developer.apple.com/ios/get-started/": {"identifier": "https://developer.apple.com/ios/get-started/", "title": "iOS Pathway", "titleInlineContent": [{"text": "iOS Pathway", "type": "text"}], "type": "link", "url": "https://developer.apple.com/ios/get-started/"}, "human-interface-guidelines-page-image-card.png": {"alt": "An illustration of several Liquid Glass components such as toggles, sliders, and buttons, atop a neutral background. The transparent components cast shadows on the background and allow their colored elements, like a blue slider track and a green toggle backing, to show through, highlighting the Liquid Glass material's lensing effect.", "identifier": "human-interface-guidelines-page-image-card.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/human-interface-guidelines-page-image-card@2x.png"}]}, "ios.svg": {"alt": "An icon of an iPhone frame.", "identifier": "ios.svg", "type": "image", "variants": [{"svgID": "designing-for-ios", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/ios.svg"}]}, "overview.svg": {"alt": "An icon of a grid comprised of four squares.", "identifier": "overview.svg", "type": "image", "variants": [{"svgID": "overview", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/overview.svg"}]}, "platforms-designing-for-ios-thumbnail.png": {"alt": "A stylized representation of an iPhone frame. The image is tinted green to subtly reflect the green in the original six-color Apple logo.", "identifier": "platforms-designing-for-ios-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/platforms-designing-for-ios-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/platforms-designing-for-ios-thumbnail~dark@2x.png"}]}, "platforms-iOS-intro.png": {"alt": "A stylized representation of an iPhone frame shown on top of a grid. The image is overlaid with rectangular and circular grid lines and is tinted green to subtly reflect the green in the original six-color Apple logo.", "identifier": "platforms-iOS-intro.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/platforms-iOS-intro@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/platforms-iOS-intro~dark@2x.png"}]}, "platforms.png": {"alt": "", "identifier": "platforms.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/platforms@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/platforms~dark@2x.png"}]}}}