it/UIAccessibilityElement/isAccessibilityElement": {"abstract": [{"text": "A Boolean value indicating whether the item is an accessibility element an assistive application can access.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "var"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "isAccessibilityElement"}, {"kind": "text", "text": ": "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:Sb", "text": "Bool"}], "identifier": "doc://com.apple.documentation/documentation/UIKit/UIAccessibilityElement/isAccessibilityElement", "kind": "symbol", "role": "symbol", "title": "isAccessibilityElement", "type": "topic", "url": "/documentation/uikit/uiaccessibilityelement/isaccessibilityelement"}, "doc://com.apple.documentation/documentation/UIKit/supporting-voiceover-in-your-app": {"abstract": [{"text": "Add VoiceOver support to make your iOS app more accessible to users who are blind or have low vision.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/UIKit/supporting-voiceover-in-your-app", "kind": "article", "role": "article", "title": "Supporting VoiceOver in your app", "type": "topic", "url": "/documentation/uikit/supporting-voiceover-in-your-app"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "doc://com.apple.documentation/documentation/visionOS/improving-accessibility-support-in-your-app": {"abstract": [{"text": "Update your code to ensure everyone can access your app\u2019s content in", "type": "text"}, {"text": " ", "type": "text"}, {"text": "visionOS.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/visionOS/improving-accessibility-support-in-your-app", "kind": "article", "role": "article", "title": "Improving accessibility support in your visionOS app", "type": "topic", "url": "/documentation/visionos/improving-accessibility-support-in-your-app"}, "doc://com.apple.documentation/videos/play/wwdc2019/254": {"abstract": [{"text": "Great accessibility labels are the difference between someone using and loving your app or someone deleting your app. Experience VoiceOver as demonstrated by an Apple Accessibility engineer as she navigates complex UI and demonstrates how descriptive labels are an easy way to ensure your app is for everyone.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2019/254", "images": [{"identifier": "23AF104C-7CFE-4F7B-AEC6-46F54121AE92", "type": "card"}], "kind": "article", "role": "article", "title": "Writing Great Accessibility Labels", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2019/254"}, "doc://com.apple.documentation/videos/play/wwdc2020/10116": {"abstract": [{"text": "Discover how you can integrate custom rotors and help people who use VoiceOver navigate complex situations within your app. Learn how custom rotors can help people explore even the most intricate interfaces, explore how to implement a custom rotor, and find out how rotors can improve navigation for someone who relies on VoiceOver.\n\nTo get the most out of this session, you should be familiar with general accessibility principles and VoiceOver accessibility APIs on iOS and iPadOS. For an overview, watch \u201cMaking Apps More Accessible with Custom Actions.\u201d", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2020/10116", "images": [{"identifier": "669BA7EE-2BAE-4B94-84E7-41D399756313", "type": "card"}], "kind": "article", "role": "article", "title": "VoiceOver efficiency with custom rotors", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2020/10116"}, "doc://com.apple.documentation/videos/play/wwdc2021/10121": {"abstract": [{"text": "Learn how to present complex data through VoiceOver with the Accessibility 