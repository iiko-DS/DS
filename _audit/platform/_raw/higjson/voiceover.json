n"}, {"identifier": "technologies.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Technologies", "type": "topic", "url": "/design/human-interface-guidelines/technologies"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/design/Human-Interface-Guidelines/charts": {"abstract": [{"text": "Organize data in a chart to communicate information with clarity and visual appeal.", "type": "text"}], "identifier": "doc://com.apple.documentation/design/Human-Interface-Guidelines/charts", "images": [{"identifier": "components-charts-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Charts", "type": "topic", "url": "/design/human-interface-guidelines/charts"}, "doc://com.apple.documentation/documentation/Accessibility": {"abstract": [{"text": "Make your apps accessible to everyone who uses Apple devices.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/Accessibility", "images": [{"identifier": "Accessibility-PageImage-card.png", "type": "card"}], "kind": "symbol", "role": "collection", "title": "Accessibility", "type": "topic", "url": "/documentation/accessibility"}, "doc://com.apple.documentation/documentation/Accessibility/AccessibilityNotification": {"abstract": [{"text": "Types of accessibility notifications that an app can post.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "enum"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "AccessibilityNotification"}], "identifier": "doc://com.apple.documentation/documentation/Accessibility/AccessibilityNotification", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "AccessibilityNotification"}], "role": "symbol", "title": "AccessibilityNotification", "type": "topic", "url": "/documentation/accessibility/accessibilitynotification"}, "doc://com.apple.documentation/documentation/Accessibility/voiceover": {"abstract": [{"text": "A gesture-based screen reader that provides an auditory description of the content onscreen.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/Accessibility/voiceover", "images": [{"identifier": "voiceover-card.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "VoiceOver", "type": "topic", "url": "/documentation/accessibility/voiceover"}, "doc://com.apple.documentation/documentation/AppKit/NSAccessibility-c.protocol/accessibilityElement": {"abstract": [{"text": "A Boolean value that determines whether the accessibility element participates in the accessibility hierarchy.", "type": "text"}], "fragments": [{"kind": "identifier", "text": "accessibilityElement"}], "identifier": "doc://com.apple.documentation/documentation/AppKit/NSAccessibility-c.protocol/accessibilityElement", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "accessibilityElement"}], "role": "symbol", "title": "accessibilityElement", "type": "topic", "url": "/documentation/appkit/nsaccessibility-c.protocol/accessibilityelement"}, "doc://com.apple.documentation/documentation/AppKit/NSAccessibilityCustomRotor": {"abstract": [{"text": "A context-sensitive function that helps VoiceOver users find the next instance of a related accessibility element.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "class"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "NSAccessibilityCustomRotor"}], "identifier": "doc://com.apple.documentation/documentation/AppKit/NSAccessibilityCustomRotor", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "NSAccessibilityCustomRotor"}], "role": "symbol", "title": "NSAccessibilityCustomRotor", "type": "topic", "url": "/documentation/appkit/nsaccessibilitycustomrotor"}, "doc://com.apple.documentation/documentation/ObjectiveC/NSObject-swift.class/shouldGroupAccessibilityChildren": {"abstract": [], "fragments": [{"kind": "keyword", "text": "var"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "shouldGroupAccessibilityChildren"}, {"kind": "text", "text": ": "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:Sb", "text": "Bool"}], "identifier": "doc://com.apple.documentation/documentation/ObjectiveC/NSObject-swift.class/shouldGroupAccessibilityChildren", "kind": "symbol", "role": "symbol", "title": "shouldGroupAccessibilityChildren", "type": "topic", "url": "/documentation/objectivec/nsobject-swift.class/shouldgroupaccessibilitychildren"}, "doc://com.apple.documentation/documentation/SwiftUI/AccessibilityRotorEntry": {"abstract": [{"text": "A struct representing an entry in an Accessibility Rotor.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "struct"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "AccessibilityRotorEntry"}], "identifier": "doc://com.apple.documentation/documentation/SwiftUI/AccessibilityRotorEntry", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "AccessibilityRotorEntry"}], "role": "symbol", "title": "AccessibilityRotorEntry", "type": "topic", "url": "/documentation/swiftui/accessibilityrotorentry"}, "doc://com.apple.documentation/documentation/SwiftUI/View-Accessibility": {"abstract": [{"text": "Make your SwiftUI apps accessible to everyone, including people with", "type": "text"}, {"text": " ", "type": "text"}, {"text": "disabilities.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/SwiftUI/View-Accessibility", "kind": "ar