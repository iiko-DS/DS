omponents": {"abstract": [{"text": "Learn how to use and customize system-defined components to give people a familiar and consistent experience.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/components", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "components.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Components", "type": "topic", "url": "/design/human-interface-guidelines/components"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/page-controls": {"abstract": [{"text": "A page control displays a row of indicator images, each of which represents a page in a flat list.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/page-controls", "images": [{"identifier": "components-page-controls-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Page controls", "type": "topic", "url": "/design/human-interface-guidelines/page-controls"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/panels": {"abstract": [{"text": "In a macOS app, a panel typically floats above other open windows providing supplementary controls, options, or information related to the active window or current selection.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/panels", "images": [{"identifier": "components-panels-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Panels", "type": "topic", "url": "/design/human-interface-guidelines/panels"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/popovers": {"abstract": [{"text": "A popover is a transient view that appears above other content when people click or tap a control or interactive area.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/popovers", "images": [{"identifier": "components-popovers-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Popovers", "type": "topic", "url": "/design/human-interface-guidelines/popovers"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/scroll-views": {"abstract": [{"text": "A scroll view lets people view content that\u2019s larger than the view\u2019s boundaries by moving the content vertically or horizontally.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/scroll-views", "images": [{"identifier": "components-scroll-views-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Scroll views", "type": "topic", "url": "/design/human-interface-guidelines/scroll-views"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/sheets": {"abstract": [{"text": "A sheet helps people perform a scoped task that\u2019s closely related to their current context.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/sheets", "images": [{"identifier": "components-sheets-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Sheets", "type": "topic", "url": "/design/human-interface-guidelines/sheets"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/windows": {"abstract": [{"text": "A window presents UI views and components in your app or game.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/windows", "images": [{"identifier": "components-windows-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Windows", "type": "topic", "url": "/design/human-interface-guidelines/windows"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "human-interface-guidelines-page-image-card.png": {"alt": "An illustration of several Liquid Glass components such as toggles, sliders, and buttons, atop a neutral background. The transparent components cast shadows on the background and allow their colored elements, like a blue slider track and a green toggle backing, to show through, highlighting the Liquid Glass material's lensing effect.", "identifier": "human-interface-guidelines-page-image-card.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/human-interface-guidelines-page-image-card@2x.png"}]}, "overview.svg": {"alt": "An icon of a grid comprised of four squares.", "identifier": "overview.svg", "type": "image", "variants": [{"svgID": "overview", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/overview.svg"}]}, "presentation.svg": {"alt": "An icon of two overlapping windows, the front of which is modal, suggesting presentation.", "identifier": "presentation.svg", "type": "image", "variants": [{"svgID": "presentation", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/presentation.svg"}]}}}