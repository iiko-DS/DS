idelines/components": {"abstract": [{"text": "Learn how to use and customize system-defined components to give people a familiar and consistent experience.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/components", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "components.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Components", "type": "topic", "url": "/design/human-interface-guidelines/components"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/digit-entry-views": {"abstract": [{"text": "A digit entry view fills the entire screen and prompts people to enter a series of digits, like a PIN, using a digit-specific keyboard.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/digit-entry-views", "images": [{"identifier": "components-digit-entry-views-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Digit entry views", "type": "topic", "url": "/design/human-interface-guidelines/digit-entry-views"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/image-wells": {"abstract": [{"text": "An image well is an editable version of an image view.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/image-wells", "images": [{"identifier": "components-image-wells-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Image wells", "type": "topic", "url": "/design/human-interface-guidelines/image-wells"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/pickers": {"abstract": [{"text": "A picker displays one or more scrollable lists of distinct values that people can choose from.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/pickers", "images": [{"identifier": "components-pickers-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Pickers", "type": "topic", "url": "/design/human-interface-guidelines/pickers"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/segmented-controls": {"abstract": [{"text": "A segmented control is a linear set of two or more segments, each of which functions as a button.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/segmented-controls", "images": [{"identifier": "components-segmented-controls-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Segmented controls", "type": "topic", "url": "/design/human-interface-guidelines/segmented-controls"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/sliders": {"abstract": [{"text": "A slider is a horizontal track with a control, called a thumb, that people can adjust between a minimum and maximum value.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/sliders", "images": [{"identifier": "components-sliders-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Sliders", "type": "topic", "url": "/design/human-interface-guidelines/sliders"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/steppers": {"abstract": [{"text": "A stepper is a two-segment control that people use to increase or decrease an incremental value.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/steppers", "images": [{"identifier": "components-steppers-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Steppers", "type": "topic", "url": "/design/human-interface-guidelines/steppers"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/text-fields": {"abstract": [{"text": "A text field is a rectangular area in which people enter or edit small, specific pieces of text.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/text-fields", "images": [{"identifier": "components-text-fields-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Text fields", "type": "topic", "url": "/design/human-interface-guidelines/text-fields"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/toggles": {"abstract": [{"text": "A toggle lets people choose between a pair of opposing states, like on and off, using a different appearance to indicate each state.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/toggles", "images": [{"identifier": "components-toggles-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Toggles", "type": "topic", "url": "/design/human-interface-guidelines/toggles"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/virtual-keyboards": {"abstract": [{"text": "On devices without physical keyboards, the system offers various types of virtual keyboards people can use to enter data.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/virtual-keyboards", "images": [{"identifier": "components-virtual-keyboards-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Virtual keyboards", "type": "topic", "url": "/design/human-interface-guidelines/virtual-keyboards"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "ro