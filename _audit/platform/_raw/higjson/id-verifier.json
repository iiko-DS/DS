nterface-guidelines"}, "doc://com.apple.documentation/documentation/ProximityReader/MobileDriversLicenseDataRequest": {"abstract": [{"text": "A mobile driver\u2019s license request that retrieves elements from the holder and returns the validated document elements.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "struct"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "MobileDriversLicenseDataRequest"}], "identifier": "doc://com.apple.documentation/documentation/ProximityReader/MobileDriversLicenseDataRequest", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "MobileDriversLicenseDataRequest"}], "role": "symbol", "title": "MobileDriversLicenseDataRequest", "type": "topic", "url": "/documentation/proximityreader/mobiledriverslicensedatarequest"}, "doc://com.apple.documentation/documentation/ProximityReader/MobileDriversLicenseDataRequest/Element/ageAtLeast(_:)": {"abstract": [{"text": "A Boolean value that indicates whether the mobile driver\u2019s license holder\u2019s age is at least the given age.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "static"}, {"kind": "text", "text": " "}, {"kind": "keyword", "text": "func"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "ageAtLeast"}, {"kind": "text", "text": "("}, {"kind": "typeIdentifier", "preciseIdentifier": "s:Si", "text": "Int"}, {"kind": "text", "text": ") -> "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:15ProximityReader31MobileDriversLicenseDataRequestV", "text": "MobileDriversLicenseDataRequest"}, {"kind": "text", "text": "."}, {"kind": "typeIdentifier", "preciseIdentifier": "s:15ProximityReader31MobileDriversLicenseDataRequestV7ElementV", "text": "Element"}], "identifier": "doc://com.apple.documentation/documentation/ProximityReader/MobileDriversLicenseDataRequest/Element/ageAtLeast(_:)", "kind": "symbol", "role": "symbol", "title": "ageAtLeast(_:)", "type": "topic", "url": "/documentation/proximityreader/mobiledriverslicensedatarequest/element/ageatleast(_:)"}, "doc://com.apple.documentation/documentation/ProximityReader/MobileDriversLicenseDisplayRequest": {"abstract": [{"text": "A mobile driver\u2019s license request that retrieves elements from the holder", "type": "text"}, {"text": " ", "type": "text"}, {"text": "and displays the results onscreen for visual inspection.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "struct"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "MobileDriversLicenseDisplayRequest"}], "identifier": "doc://com.apple.documentation/documentation/ProximityReader/MobileDriversLicenseDisplayRequest", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "MobileDriversLicenseDisplayRequest"}], "role": "symbol", "title": "MobileDriversLicenseDisplayRequest", "type": "topic", "url": "/documentation/proximityreader/mobiledriverslicensedisplayrequest"}, "doc://com.apple.documentation/documentation/ProximityReader/MobileDriversLicenseRawDataRequest": {"abstract": [{"text": "A mobile driver\u2019s license request which retrieves elements from the holder and returns the raw response data for processing.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "struct"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "MobileDriversLicenseRawDataRequest"}], "identifier": "doc://com.apple.documentation/documentation/ProximityReader/MobileDriversLicenseRawDataRequest", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "MobileDriversLicenseRawDataRequest"}], "role": "symbol", "title": "MobileDriversLicenseRawDataRequest", "type": "topic", "url": "/documentation/proximityreader/mobiledriverslicenserawdatarequest"}, "doc://com.apple.documentation/documentation/ProximityReader/adopting-the-verifier-api-in-your-iphone-app": {"abstract": [{"text": "Configure and test ID Verifier support in your app for reading mobile documents.", "type": "text"}], "identifier": "doc://com.apple.documentation/documentation/ProximityReader/adopting-the-verifier-api-in-your-iphone-app", "kind": "article", "role": "article", "title": "Adopting the Verifier API in your iPhone app", "type": "topic", "url": "/documentation/proximityreader/adopting-the-verifier-api-in-your-iphone-app"}, "doc://com.apple.documentation/documentation/technologies": {"abstract": [], "identifier": "doc://com.apple.documentation/documentation/technologies", "kind": "technologies", "role": "overview", "title": "Technologies", "type": "topic", "url": "/documentation/technologies"}, "doc://com.apple.documentation/videos/play/wwdc2023/10114": {"abstract": [{"text": "Discover the latest updates to Wallet and Apple Pay. Learn how to take advantage of preauthorized payments, funds transfer, and Apple Pay Later merchandising to create great Apple Pay experiences in your app or for the web. Explore improved support for Mail, Messages, Safari, and third-party apps in Wallet Order Tracking, and find out how you can add more information to an order\u2019s transaction or receipt details. And we\u2019ll introduce you to Tap to Present ID on iPhone (or ID Verifier), a new way to accept IDs in Wallet using iPhone \u2014 no additional hardware needed.", "type": "text"}], "identifier": "doc://com.apple.documentation/videos/play/wwdc2023/10114", "images": [{"identifier": "0F2B5692-7E7D-4716-9E5F-63E4A4FA13ED", "type": "card"}], "kind": "article", "role": "article", "title": "What\u2019s new in Wallet and Apple Pay", "type": "topic", "url": "https://developer.apple.com/videos/play/wwdc2023/10114"}, "https://developer.apple.com/wallet/id-verifier/": {"identifier": "https://developer.apple.com/wallet/id-verifier/", "title": "Get started with ID Verifier", "titleInlineContent": [{"text": "Get started with ID Verifier", "type": "text"}], "type": "link", "url": "https://developer.apple.com/wallet/id-verifier/"}, "https://learn.wallet.apple/id": {"identifier": "https://learn.wallet.apple/id", "title": "IDs in Wallet", "titleInlineContent": [{"text": "IDs in Wallet", "type": "text"}], "type": "link", "url": "https://learn.wallet.apple/id"}, "https://register.apple.com/services/login?returnTo=/signin/tap-to-present-id-on-iphone": {"identifier": "https://register.apple.com/services/login?returnTo=/signin/tap-to-present-id-on-iphone", "title": "Apple Business Register", "titleInlineContent": [{"text": "Apple Business Register", "type": "text"}], "type": "link", "url": "https://register.apple.com/services/login?returnTo=/signin/tap-to-present-id-on-iphone"}, "human-interface-guidelines-page-image-card.png": {"alt": "An illustration of several Liquid Glass components such as toggles, sliders, and buttons, atop a neutral background. The transparent components cast shadows on the background and allow their colored elements, like a blue slider track and a green toggle backing, to show through, highlighting the Liquid Glass material's lensing effect.", "identifier": "human-interface-guidelines-page-image-card.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/human-interface-guidelines-page-image-card@2x.png"}]}, "id-verifier-button-age.png": {"alt": "An illustration of a Verify Age button.", "identifier": "id-verifier-button-age.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/id-verifier-button-age@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/id-verifier-button-age~dark@2x.png"}]}, "id-verifier-button-identity.png": {"alt": "An illustration of a Verify Identity button.", "identifier": "id-verifier-button-identity.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/id-verifier-button-identity@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/id-verifier-button-identity~dark@2x.png"}]}, "id-verifier.svg": {"alt": "An icon of progressively larger curved lines emerging from the bottom corner of an ID card, suggesting ID Verifier.", "identifier": "id-verifier.svg", "type": "image", "variants": [{"svgID": "Design-Spec", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/id-verifier.svg"}]}, "overview.svg": {"alt": "An icon of a grid comprised of four squares.", "identifier": "overview.svg", "type": "image", "variants": [{"svgID": "overview", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/overview.svg"}]}, "technologies-ID-Verifier-Apps-intro.png": {"alt": "A sketch of progressively larger curved lines emerging from the bottom corner of an ID card, suggesting ID Verifier. The image is overlaid with rectangular and circular grid lines and is tinted blue to subtly reflect the blue in the original six-color Apple logo.", "identifier": "technologies-ID-Verifier-Apps-intro.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/technologies-ID-Verifier-Apps-intro@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/technologies-ID-Verifier-Apps-intro~dark@2x.png"}]}, "technologies-id-verifier-apps-thumbnail.png": {"alt": "A sketch of progressively larger curved lines emerging from the bottom corner of an ID card, suggesting ID Verifier. The image is tinted blue to subtly reflect the blue in the original six-color Apple logo.", "identifier": "technologies-id-verifier-apps-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/technologies-id-verifier-apps-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/technologies-id-verifier-apps-thumbnail~dark@2x.png"}]}, "technologies.png": {"alt": "", "identifier": "technologies.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/technologies@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/technologies~dark@2x.png"}]}}}