{"abstract": [{"text": "The Camera Control provides direct access to your app\u2019s camera experience.", "type": "text"}], "hierarchy": {"paths": [["doc://com.apple.documentation/documentation/technologies", "doc://com.apple.HIG/design/human-interface-guidelines", "doc://com.apple.HIG/design/Human-Interface-Guidelines/inputs"]]}, "identifier": {"interfaceLanguage": "swift", "url": "doc://com.apple.HIG/design/Human-Interface-Guidelines/camera-control"}, "kind": "article", "legalNotices": {"copyright": "Copyright &copy; 2026 Apple Inc. All rights reserved.", "privacyPolicy": "https://www.apple.com/privacy/privacy-policy", "termsOfUse": "https://www.apple.com/legal/internet-services/terms/site.html"}, "metadata": {"availableLanguages": ["en-US", "zh-CN", "ja-JP", "ko-KR"], "customMetadata": {"alert-date": "2024-09-09", "alert-text": "New page.", "supported-platforms": "ios"}, "images": [{"identifier": "camera-control.svg", "type": "icon"}, {"identifier": "inputs-camera-control-thumbnail.png", "type": "card"}], "role": "article", "title": "Camera Control"}, "primaryContentSections": [{"content": [{"inlineContent": [{"identifier": "inputs-camera-control-intro.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"text": "On iPhone 16 and iPhone 16 Pro models, the Camera Control quickly opens your app\u2019s camera experience to capture moments as they happen. When a person lightly presses the Camera Control, the system displays an overlay that extends from the device bezel.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "camera-control-button-callout.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"text": "The overlay allows people to quickly adjust controls. A person can view the available controls by lightly double-pressing the Camera Control. After selecting a control, they can slide their finger on the Camera Control to adjust a value to capture their content as they want.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "camera-control-picker.png", "metadata": {"abstract": [{"text": "Controls in the overlay", "type": "text"}]}, "type": "image"}], "type": "paragraph"}, {"anchor": "Anatomy", "level": 2, "text": "Anatomy", "type": "heading"}, {"inlineContent": [{"text": "The Camera Control offers two types of controls for adjusting values or changing between options:", "type": "text"}], "type": "paragraph"}, {"items": [{"content": [{"inlineContent": [{"text": "A ", "type": "text"}, {"inlineContent": [{"text": "slider", "type": "text"}], "type": "emphasis"}, {"text": " provides a range of values to choose from, such as how much contrast to apply to the content.", "type": "text"}], "type": "paragraph"}]}, {"content": [{"inlineContent": [{"text": "A ", "type": "text"}, {"inlineContent": [{"text": "picker", "type": "text"}], "type": "emphasis"}, {"text": " offers discrete options, such as turning a grid on and off in the viewfinder.", "type": "text"}], "type": "paragraph"}]}], "type": "unorderedList"}, {"columns": [{"alignment": "leading", "content": [{"inlineContent": [{"identifier": "camera-control-slider-control.png", "metadata": {"abstract": [{"text": "Slider control", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}, {"alignment": "leading", "content": [{"inlineContent": [{"identifier": "camera-control-picker-control.png", "metadata": {"abstract": [{"text": "Picker control", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}], "numberOfColumns": 2, "type": "row"}, {"inlineContent": [{"text": "In addition to custom controls that you create, the system provides a set of standard controls that you can optionally include in the overlay to allow someone to adjust their camera\u2019s zoom and exposure.", "type": "text"}], "type": "paragraph"}, {"columns": [{"alignment": "leading", "content": [{"inlineContent": [{"identifier": "system-control-type-zoom-factor.png", "metadata": {"abstract": [{"text": "Zoom factor control", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}, {"alignment": "leading", "content": [{"inlineContent": [{"identifier": "system-control-type-exposure-bias.png", "metadata": {"abstract": [{"text": "Exposure bias control", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}], "numberOfColumns": 2, "type": "row"}, {"anchor": "Best-practices", "level": 2, "text": "Best practices", "type": "heading"}, {"inlineContent": [{"inlineContent": [{"text": "Use SF Symbols to represent control functionality.", "type": "text"}], "type": "strong"}, {"text": " The system doesn\u2019t support custom symbols; instead, pick a symbol from SF Symbols that clearly denotes a control\u2019s behavior. iOS offers thousands of symbols you can use to represent the controls your app shows in the overlay. Symbols for controls don\u2019t represent their current state. To view available symbols, see the Camera & Photos section in the ", "type": "text"}, {"identifier": "https://developer.apple.com/sf-symbols/", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"columns": [{"alignment": "leading", "content": [{"inlineContent": [{"identifier": "camera-control-picker-sf-symbols-flash.png", "metadata": {"abstract": [{"text": "The ", "type": "text"}, {"code": "bolt.fill", "type": "codeVoice"}, {"text": " symbol that represents a control for the camera flash", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}, {"alignment": "leading", "content": [{"inlineContent": [{"identifier": "camera-control-picker-sf-symbols-filters.png", "metadata": {"abstract": [{"text": "The ", "type": "text"}, {"code": "camera.filters", "type": "codeVoice"}, {"text": " symbol that represents a control for filters", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}], "numberOfColumns": 2, "type": "row"}, {"inlineContent": [{"inlineContent": [{"text": "Keep names of controls short.", "type": "text"}], "type": "strong"}, {"text": " Control labels adhere to Dynamic Type sizes, and longer names may obfuscate the camera\u2019s viewfinder.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Include units or symbols with slider control values to provide context.", "type": "text"}], "type": "strong"}, {"text": " Providing descriptive information in the overlay, such as EV, %, or a custom string, helps people understand what the slider controls. For developer guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureSlider/localizedValueFormat", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"columns": [{"alignment": "leading", "content": [{"inlineContent": [{"identifier": "system-control-with-label.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "checkmark.png", "metadata": {"abstract": [{"text": "Value with context", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}, {"alignment": "leading", "content": [{"inlineContent": [{"identifier": "system-control-no-label.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "crossout.png", "metadata": {"abstract": [{"text": "Value without context", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}], "numberOfColumns": 2, "type": "row"}, {"inlineContent": [{"inlineContent": [{"text": "Define prominent values for a slider control.", "type": "text"}], "type": "strong"}, {"text": " Prominent values are ones people choose most frequently, or values that are evenly spaced, like the major increments of zoom factor. When a person slides on the Camera Control to adjust a slider control, the system more easily lands on prominent values you define. For developer guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureSlider/prominentValues-199dz", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Make space for the overlay in the viewfinder.", "type": "text"}], "type": "strong"}, {"text": " The overlay and control labels occupy the screen area adjacent to the Camera Control in both portrait and landscape orientations. To avoid overlapping the interface elements of your camera capture experience, place your UI outside of the overlay areas. Maximize the height and width of the viewfinder and allow the overlay to appear and disappear over it.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "camera-control-portrait-landscape-orientation.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Minimize distractions in the viewfinder.", "type": "text"}], "type": "strong"}, {"text": " When capturing a photo or video, people appreciate a large preview image with as few visual distractions as possible. Avoid duplicating controls, like sliders and toggles, in your UI and the overlay when the system displays the overlay.", "type": "text"}], "type": "paragraph"}, {"columns": [{"alignment": "leading", "content": [{"inlineContent": [{"identifier": "camera-control-screen-ui-good-example.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "checkmark.png", "metadata": {"abstract": [{"text": "Keep UI minimal.", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}, {"alignment": "leading", "content": [{"inlineContent": [{"identifier": "camera-control-screen-ui-bad-example.png", "type": "image"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "crossout.png", "metadata": {"abstract": [{"text": "Avoid showing controls in the viewfinder that people access in the overlay.", "type": "text"}]}, "type": "image"}], "type": "paragraph"}], "size": 1}], "numberOfColumns": 2, "type": "row"}, {"inlineContent": [{"inlineContent": [{"text": "Enable or disable controls depending on the camera mode.", "type": "text"}], "type": "strong"}, {"text": " For example, disable video controls when taking photos. The overlay supports multiple controls, but you can\u2019t remove or add controls at runtime.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Consider how to arrange your controls.", "type": "text"}], "type": "strong"}, {"text": " Order commonly used controls toward the middle to allow quick access, and include lesser used controls on either side. When a person lightly presses the Camera Control to open the overlay again, the system remembers the last control they used in your app.", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"inlineContent": [{"text": "Allow people to use the Camera Control to launch your experience from anywhere.", "type": "text"}], "type": "strong"}, {"text": " Create a locked camera capture extension that lets people configure the Camera Control to launch your app\u2019s camera experience from their locked device, the Home Screen, or from within other apps. For guidance, see ", "type": "text"}, {"identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/controls#Camera-experiences-on-a-locked-device", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"anchor": "Platform-considerations", "level": 2, "text": "Platform considerations", "type": "heading"}, {"inlineContent": [{"inlineContent": [{"text": "Not supported in iPadOS, macOS, watchOS, tvOS, or visionOS.", "type": "text"}], "type": "emphasis"}], "type": "paragraph"}, {"anchor": "Resources", "level": 2, "text": "Resources", "type": "heading"}, {"anchor": "Related", "level": 4, "text": "Related", "type": "heading"}, {"inlineContent": [{"identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/sf-symbols", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/controls", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"anchor": "Developer-documentation", "level": 4, "text": "Developer documentation", "type": "heading"}, {"inlineContent": [{"identifier": "doc://com.apple.documentation/documentation/AVFoundation/enhancing-your-app-experience-with-the-camera-control", "isActive": true, "type": "reference"}, {"text": " \u2014 AVFoundation", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureControl", "isActive": true, "type": "reference"}, {"text": " \u2014 AVFoundation", "type": "text"}], "type": "paragraph"}, {"inlineContent": [{"identifier": "doc://com.apple.documentation/documentation/LockedCameraCapture", "isActive": true, "type": "reference"}], "type": "paragraph"}, {"anchor": "Change-log", "level": 2, "text": "Change log", "type": "heading"}, {"header": "row", "rows": [[[{"inlineContent": [{"text": "Date", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "Changes", "type": "text"}], "type": "paragraph"}]], [[{"inlineContent": [{"text": "September 9, 2024", "type": "text"}], "type": "paragraph"}], [{"inlineContent": [{"text": "New page.", "type": "text"}], "type": "paragraph"}]]], "type": "table"}], "kind": "content"}], "schemaVersion": {"major": 0, "minor": 3, "patch": 0}, "sections": [], "topicSectionsStyle": "compactGrid", "references": {"camera-control-PageImage-card.png": {"alt": "An image that displays a horizontal row of capture controls with the Zoom control highlighted.", "identifier": "camera-control-PageImage-card.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.avfoundation/camera-control-PageImage-card@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.avfoundation/camera-control-PageImage-card~dark@2x.png"}]}, "camera-control-button-callout.png":