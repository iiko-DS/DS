ht"], "url": "/images/com.apple.HIG/camera-control-picker@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/camera-control-picker~dark@2x.png"}]}, "camera-control-portrait-landscape-orientation.png": {"alt": "Partial screenshots showing the Camera Control overlay with its control's label in the viewport in portrait and landscape orientations on iPhone.", "identifier": "camera-control-portrait-landscape-orientation.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/camera-control-portrait-landscape-orientation@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/camera-control-portrait-landscape-orientation~dark@2x.png"}]}, "camera-control-screen-ui-bad-example.png": {"alt": "A partial screenshot showing an example of the Camera Control overlay with UI elements duplicated in the capture viewport.", "identifier": "camera-control-screen-ui-bad-example.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/camera-control-screen-ui-bad-example@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/camera-control-screen-ui-bad-example~dark@2x.png"}]}, "camera-control-screen-ui-good-example.png": {"alt": "A partial screenshot showing an example of the Camera Control overlay with UI elements removed from the capture viewport.", "identifier": "camera-control-screen-ui-good-example.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/camera-control-screen-ui-good-example@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/camera-control-screen-ui-good-example~dark@2x.png"}]}, "camera-control-slider-control.png": {"alt": "A partial screenshot of the Camera Control overlay displaying a slider control.", "identifier": "camera-control-slider-control.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/camera-control-slider-control@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/camera-control-slider-control~dark@2x.png"}]}, "camera-control.svg": {"alt": "An icon of an arrow pointing toward the Camera Control on iPhone.", "identifier": "camera-control.svg", "type": "image", "variants": [{"svgID": "camera-control", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/camera-control.svg"}]}, "checkmark.png": {"alt": "A checkmark in a circle to indicate correct usage.", "identifier": "checkmark.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/checkmark@2x.png"}]}, "components-controls-thumbnail.png": {"alt": "A stylized representation of empty controls in Control Center that are different sizes. The image is tinted red to subtly reflect the red in the original six-color Apple logo.", "identifier": "components-controls-thumbnail.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/components-controls-thumbnail@2x.png"}, {"traits": ["2x", "dark"], "url": "/images/com.apple.HIG/components-controls-thumbnail~dark@2x.png"}]}, "crossout.png": {"alt": "An X in a circle to indicate incorrect usage.", "identifier": "crossout.png", "type": "image", "variants": [{"traits": ["2x", "light"], "url": "/images/com.apple.HIG/crossout@2x.png"}]}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/controls": {"abstract": [{"text": "A control provides quick access to a feature of your app from Control Center, the Lock Screen, or the Action button.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/controls", "images": [{"identifier": "components-controls-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Controls", "type": "topic", "url": "/design/human-interface-guidelines/controls"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/controls#Camera-experiences-on-a-locked-device": {"abstract": [], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/controls#Camera-experiences-on-a-locked-device", "kind": "section", "title": "Camera experiences on a locked device", "type": "topic", "url": "/design/human-interface-guidelines/controls#Camera-experiences-on-a-locked-device"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/inputs": {"abstract": [{"text": "Learn about the various methods people use to control your app or game and enter data.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/inputs", "images": [{"identifier": "overview.svg", "type": "icon"}, {"identifier": "inputs.png", "type": "card"}], "kind": "article", "role": "collectionGroup", "title": "Inputs", "type": "topic", "url": "/design/human-interface-guidelines/inputs"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/sf-symbols": {"abstract": [{"text": "SF Symbols provides thousands of consistent, highly configurable symbols that integrate seamlessly with the San Francisco system font, automatically aligning with text in all weights and sizes.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/sf-symbols", "images": [{"identifier": "sf-symbols.svg", "type": "icon"}, {"identifier": "foundations-sf-symbols-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "SF Symbols", "type": "topic", "url": "/design/human-interface-guidelines/sf-symbols"}, "doc://com.apple.HIG/design/human-interface-guidelines": {"abstract": [{"text": "The HIG contains guidance and best practices that can help you design a", "type": "text"}, {"text": " ", "type": "text"}, {"text": "great experience for any Apple platform.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/human-interface-guidelines", "images": [{"identifier": "human-interface-guidelines-page-image-card.png", "type": "card"}], "kind": "article", "role": "collection", "title": "Human Interface Guidelines", "type": "topic", "url": "/design/human-interface-guidelines"}, "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureControl": {"abstract": [{"text": "An abstract base class for controls that interact with the camera system.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "class"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "AVCaptureControl"}], "identifier": "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureControl", "kind": "symbol", "navigatorTitle": [{"kind": "identifier", "text": "AVCaptureControl"}], "role": "symbol", "title": "AVCaptureControl", "type": "topic", "url": "/documentation/avfoundation/avcapturecontrol"}, "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureSlider/localizedValueFormat": {"abstract": [{"text": "A localized string that defines the presentation of the slider\u2019s value.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "var"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "localizedValueFormat"}, {"kind": "text", "text": ": "}, {"kind": "typeIdentifier", "preciseIdentifier": "s:SS", "text": "String"}, {"kind": "text", "text": "?"}], "identifier": "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureSlider/localizedValueFormat", "kind": "symbol", "role": "symbol", "title": "localizedValueFormat", "type": "topic", "url": "/documentation/avfoundation/avcaptureslider/localizedvalueformat"}, "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureSlider/prominentValues-199dz": {"abstract": [{"text": "Values in this array may receive unique visual representations or behaviors.", "type": "text"}], "fragments": [{"kind": "keyword", "text": "var"}, {"kind": "text", "text": " "}, {"kind": "identifier", "text": "prominentValues"}, {"kind": "text", "text": ": ["}, {"kind": "typeIdentifier", "preciseIdentifier": "s:Sf", "text": "Float"}, {"kind": "text", "text": "]"}], "identifier": "doc://com.apple.documentation/documentation/AVFoundation/AVCaptureSlider/prominentValues-199dz", "kind": "symb