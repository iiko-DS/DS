esigning-for-games": {"abstract": [{"text": "When people play your game on an Apple device, they dive into the world you designed while relying on the platform features they love.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-games", "images": [{"identifier": "designing-for-games.svg", "type": "icon"}, {"identifier": "platforms-designing-for-games-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Designing for games", "type": "topic", "url": "/design/human-interface-guidelines/designing-for-games"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-ios": {"abstract": [{"text": "People depend on their iPhone to help them stay connected, play games, view", "type": "text"}, {"text": " ", "type": "text"}, {"text": "media, accomplish tasks, and track personal data in any location and while on", "type": "text"}, {"text": " ", "type": "text"}, {"text": "the go.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-ios", "images": [{"identifier": "ios.svg", "type": "icon"}, {"identifier": "platforms-designing-for-ios-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Designing for iOS", "type": "topic", "url": "/design/human-interface-guidelines/designing-for-ios"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-ipados": {"abstract": [{"text": "People value the power, mobility, and flexibility of iPad as they enjoy media, play games, perform detailed productivity tasks, and bring their creations to life.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-ipados", "images": [{"identifier": "ipados.svg", "type": "icon"}, {"identifier": "platforms-designing-for-ipados-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Designing for iPadOS", "type": "topic", "url": "/design/human-interface-guidelines/designing-for-ipados"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-iphone-duo": {"abstract": [{"text": "An app designed for iPhone Duo adapts seamlessly to both displays, providing a continuous experience as the device opens and closes.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-iphone-duo", "images": [{"identifier": "designing-for-iphone.svg", "type": "icon"}, {"identifier": "platforms-designing-for-iphone-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Designing for iPhone Duo", "type": "topic", "url": "/design/human-interface-guidelines/designing-for-iphone-duo"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-macos": {"abstract": [{"text": "People rely on the power, spaciousness, and flexibility of a Mac as they perform in-depth productivity tasks, view media or content, and play games, often using several apps at once.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-macos", "images": [{"identifier": "macos.svg", "type": "icon"}, {"identifier": "platforms-designing-for-macos-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Designing for macOS", "type": "topic", "url": "/design/human-interface-guidelines/designing-for-macos"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-tvos": {"abstract": [{"text": "People enjoy the vibrant content, immersive experiences, and streamlined interactions that tvOS delivers in media and games, as well as in fitness, education, and home utility apps.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/designing-for-tvos", "images": [{"identifier": "tvos.svg", "type": "icon"}, {"identifier": "platforms-designing-for-tvos-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Designing for tvOS", "type": "topic",