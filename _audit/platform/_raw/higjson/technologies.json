r": "apple-pay.svg", "type": "image", "variants": [{"svgID": "apple-pay", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/apple-pay.svg"}]}, "augmented-reality.svg": {"alt": "An icon of an AR icon that suggests augmented reality.", "identifier": "augmented-reality.svg", "type": "image", "variants": [{"svgID": "augmented-reality", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/augmented-reality.svg"}]}, "carekit.svg": {"alt": "The CareKit icon.", "identifier": "carekit.svg", "type": "image", "variants": [{"svgID": "carekit", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/carekit.svg"}]}, "carplay.svg": {"alt": "The CarPlay icon.", "identifier": "carplay.svg", "type": "image", "variants": [{"svgID": "carplay", "traits": ["1x", "light"], "url": "/images/com.apple.HIG/carplay.svg"}]}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/airplay": {"abstract": [{"text": "AirPlay lets people stream media content wirelessly from iOS, iPadOS, macOS, and tvOS devices to Apple TV, HomePod, and TVs and speakers that support AirPlay.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/airplay", "images": [{"identifier": "airplay.svg", "type": "icon"}, {"identifier": "technologies-airplay-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "AirPlay", "type": "topic", "url": "/design/human-interface-guidelines/airplay"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/always-on": {"abstract": [{"text": "On devices that include the Always On display, the system can continue to display an app\u2019s interface when people suspend their interactions with the device.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/always-on", "images": [{"identifier": "always-on.svg", "type": "icon"}, {"identifier": "technologies-always-on-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Always On", "type": "topic", "url": "/design/human-interface-guidelines/always-on"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/app-clips": {"abstract": [{"text": "An App Clip is a lightweight version of your app or game that provides an on-the-go or demo experience that\u2019s instantly available.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/app-clips", "images": [{"identifier": "app-clips.svg", "type": "icon"}, {"identifier": "technologies-app-clips-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "App Clips", "type": "topic", "url": "/design/human-interface-guidelines/app-clips"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/apple-pay": {"abstract": [{"text": "Apple Pay is a secure, easy way to make payments for physical goods and services, donations, and subscriptions in apps and in any browser.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/apple-pay", "images": [{"identifier": "apple-pay.svg", "type": "icon"}, {"identifier": "technologies-apple-pay-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Apple Pay", "type": "topic", "url": "/design/human-interface-guidelines/apple-pay"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/augmented-reality": {"abstract": [{"text": "Augmented reality (or AR) lets you deliver immersive, engaging experiences that seamlessly blend virtual objects with the real world.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/augmented-reality", "images": [{"identifier": "augmented-reality.svg", "type": "icon"}, {"identifier": "technologies-augmented-reality-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Augmented reality", "type": "topic", "url": "/design/human-interface-guidelines/augmented-reality"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/carekit": {"abstract": [{"text": "People can use CareKit apps to manage care plans related to a chronic illness like diabetes, recover from an injury or surgery, or achieve health and wellness goals.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/carekit", "images": [{"identifier": "carekit.svg", "type": "icon"}, {"identifier": "technologies-carekit-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "CareKit", "type": "topic", "url": "/design/human-interface-guidelines/carekit"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/carplay": {"abstract": [{"text": "CarPlay lets people get directions, make calls, send and receive messages, listen to music, and more from their car\u2019s built-in display, all while staying focused on the road.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/carplay", "images": [{"identifier": "carplay.svg", "type": "icon"}, {"identifier": "technologies-carplay-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "CarPlay", "type": "topic", "url": "/design/human-interface-guidelines/carplay"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/game-center": {"abstract": [{"text": "Game Center is Apple\u2019s social gaming network, which lets players track their progress and connect with friends across Apple platforms, and boosts the discovery of your game across players\u2019 devices.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/game-center", "images": [{"identifier": "game-center.svg", "type": "icon"}, {"identifier": "technologies-game-center-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Game Center", "type": "topic", "url": "/design/human-interface-guidelines/game-center"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/generative-ai": {"abstract": [{"text": "Generative AI empowers you to enhance your app or game with dynamic content and offer intelligent features that unlock new levels of creativity, connection, and productivity.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/generative-ai", "images": [{"identifier": "generative-ai.svg", "type": "icon"}, {"identifier": "technologies-generative-ai-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Generative AI", "type": "topic", "url": "/design/human-interface-guidelines/generative-ai"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/healthkit": {"abstract": [{"text": "HealthKit is the central repository for health and fitness data in iOS, iPadOS, and watchOS.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/healthkit", "images": [{"identifier": "healthkit.svg", "type": "icon"}, {"identifier": "technologies-healthkit-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "HealthKit", "type": "topic", "url": "/design/human-interface-guidelines/healthkit"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/homekit": {"abstract": [{"text": "HomeKit lets people securely control connected accessories in their homes using Siri or the Home app on iPhone, iPad, Apple Watch, and Mac.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/homekit", "images": [{"identifier": "homekit.svg", "type": "icon"}, {"identifier": "technologies-homekit-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "HomeKit", "type": "topic", "url": "/design/human-interface-guidelines/homekit"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/icloud": {"abstract": [{"text": "iCloud is a service that lets people seamlessly access the content they care about \u2014 photos, videos, documents, and more \u2014 from any device, without performing explicit synchronization.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/icloud", "images": [{"identifier": "icloud.svg", "type": "icon"}, {"identifier": "technologies-icloud-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "iCloud", "type": "topic", "url": "/design/human-interface-guidelines/icloud"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/id-verifier": {"abstract": [{"text": "ID Verifier lets your iPhone app read mobile IDs in person without requiring external hardware.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/id-verifier", "images": [{"identifier": "id-verifier.svg", "type": "icon"}, {"identifier": "technologies-id-verifier-apps-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "ID Verifier", "type": "topic", "url": "/design/human-interface-guidelines/id-verifier"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/imessage-apps-and-stickers": {"abstract": [{"text": "An iMessage app can help people share content, collaborate, and even play games with others in a conversation; stickers are images that people can use to decorate a conversation.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/imessage-apps-and-stickers", "images": [{"identifier": "imessage-app.svg", "type": "icon"}, {"identifier": "technologies-imessage-apps-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "iMessage apps and stickers", "type": "topic", "url": "/design/human-interface-guidelines/imessage-apps-and-stickers"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/in-app-purchase": {"abstract": [{"text": "People can use in-app purchase to pay for virtual goods \u2014 like premium content, digital goods, and subscriptions \u2014 securely within your app.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/in-app-purchase", "images": [{"identifier": "in-app-purchase.svg", "type": "icon"}, {"identifier": "technologies-in-app-purchase-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "In-app purchase", "type": "topic", "url": "/design/human-interface-guidelines/in-app-purchase"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/live-photos": {"abstract": [{"text": "Live Photos lets people capture favorite memories in a sound- and motion-rich interactive experience that adds vitality to traditional still photos.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/live-photos", "images": [{"identifier": "live-photos.svg", "type": "icon"}, {"identifier": "technologies-live-photos-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Live Photos", "type": "topic", "url": "/design/human-interface-guidelines/live-photos"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/mac-catalyst": {"abstract": [{"text": "When you use Mac Catalyst to create a Mac version of your iPad app, you give people the opportunity to enjoy the experience in a new environment.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/mac-catalyst", "images": [{"identifier": "mac-catalyst.svg", "type": "icon"}, {"identifier": "technologies-mac-catalyst-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Mac Catalyst", "type": "topic", "url": "/design/human-interface-guidelines/mac-catalyst"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/machine-learning": {"abstract": [{"text": "Machine learning enables apps and games to learn from data and usage patterns, letting you improve existing experiences and create engaging new ones.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/machine-learning", "images": [{"identifier": "machine-learning.svg", "type": "icon"}, {"identifier": "technologies-machine-learning-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Machine learning", "type": "topic", "url": "/design/human-interface-guidelines/machine-learning"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/maps": {"abstract": [{"text": "A map displays outdoor or indoor geographical data in your app or on your website.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/maps", "images": [{"identifier": "maps.svg", "type": "icon"}, {"identifier": "technologies-maps-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Maps", "type": "topic", "url": "/design/human-interface-guidelines/maps"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/nfc": {"abstract": [{"text": "Near-field communication (NFC) allows devices within a few centimeters of each other to exchange information wirelessly.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/nfc", "images": [{"identifier": "nfc.svg", "type": "icon"}, {"identifier": "technologies-nfc-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "NFC", "type": "topic", "url": "/design/human-interface-guidelines/nfc"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/photo-editing": {"abstract": [{"text": "Photo-editing extensions let people modify photos and videos within the Photos app by applying filters or making other changes.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/photo-editing", "images": [{"identifier": "photo-editing.svg", "type": "icon"}, {"identifier": "technologies-photo-editing-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "Photo editing", "type": "topic", "url": "/design/human-interface-guidelines/photo-editing"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/researchkit": {"abstract": [{"text": "A research app lets people everywhere participate in important medical research studies.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/researchkit", "images": [{"identifier": "researchkit.svg", "type": "icon"}, {"identifier": "technologies-researchkit-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "ResearchKit", "type": "topic", "url": "/design/human-interface-guidelines/researchkit"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/shareplay": {"abstract": [{"text": "SharePlay lets people experience activities together from anywhere, whether they\u2019re watching a movie, playing a game, or sketching on a whiteboard.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/shareplay", "images": [{"identifier": "shareplay.svg", "type": "icon"}, {"identifier": "technologies-shareplay-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "SharePlay", "type": "topic", "url": "/design/human-interface-guidelines/shareplay"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/shazamkit": {"abstract": [{"text": "ShazamKit supports audio recognition by matching an audio sample against the ShazamKit catalog or a custom audio catalog.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/shazamkit", "images": [{"identifier": "shazamkit.svg", "type": "icon"}, {"identifier": "technologies-shazamkit-thumbnail.png", "type": "card"}], "kind": "article", "role": "article", "title": "ShazamKit", "type": "topic", "url": "/design/human-interface-guidelines/shazamkit"}, "doc://com.apple.HIG/design/Human-Interface-Guidelines/sign-in-with-apple": {"abstract": [{"text": "Sign in with Apple provides a fast, private way to sign into apps and websites, giving people a consistent experience they can trust and the convenience of not having to remember multiple accounts and passwords.", "type": "text"}], "identifier": "doc://com.apple.HIG/design/Human-Interface-Guidelines/sign-in-with-apple", "images": [{"identifier": "sign-in-with-apple.svg", "type": "icon"}, {"identifier": "technologies-sign-in-with-apple-thumbn